#!/bin/sh /etc/rc.common
# Run the normal postinst only after the persistent N1 filesystem is mounted.
# This service exists only inside the native OpenWrt package.
START=94
STOP=9

start() {
    [ -x /usr/libexec/tvguard-package-postinst ] || return 1

    awk '$2 == "/mnt/mmcblk2p4" { found=1 } END { exit !found }' /proc/mounts || {
        logger -t tvguard 'native first-boot setup deferred: persistent volume not mounted'
        return 1
    }

    /usr/libexec/tvguard-package-postinst || return 1
    /etc/init.d/tvguard-native-bootstrap disable || return 1
}
