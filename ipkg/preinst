#!/bin/sh
# Preserve the exact live configuration, accounting state and Agent pairing
# key before opkg removes the v0.1.13 packages. The first integrated release
# replaces both luci-app-tvguard and tvguard-agent-bridge.
[ -n "${IPKG_INSTROOT:-}" ] && exit 0
set -u
umask 077

MARK=/tmp/tvguard-config-restore-needed
UPGRADE=/tmp/tvguard-v014-upgrade
PENDING="$UPGRADE/pending"

atomic_copy() {
    src="$1"
    dst="$2"
    [ -f "$src" ] || return 1
    tmp="${dst}.$$"
    cp "$src" "$tmp" || { rm -f "$tmp"; return 1; }
    chmod 600 "$tmp" 2>/dev/null || :
    mv -f "$tmp" "$dst"
}

if [ -f /etc/config/tvguard ]; then
    rm -f "$MARK"
    mkdir -p "$UPGRADE"
    chmod 700 "$UPGRADE"

    # Snapshot UCI before the legacy v0.1.13 prerm can run "enforce off".
    atomic_copy /etc/config/tvguard "$UPGRADE/config" || exit 1

    # Flush the latest RAM accounting snapshot to durable storage first.
    # sync does not add viewing time; it only makes the current count durable.
    if [ -x /usr/libexec/tvguardctl ]; then
        /usr/libexec/tvguardctl sync >/dev/null 2>&1 || :
    fi

    state_src=''
    if [ -r /var/run/tvguard.state ]; then
        state_src=/var/run/tvguard.state
    elif [ -x /usr/libexec/tvguard-data ]; then
        data_root="$(/usr/libexec/tvguard-data root 2>/dev/null || :)"
        [ -n "$data_root" ] && [ -r "$data_root/state" ] && state_src="$data_root/state"
    elif [ -r /mnt/mmcblk2p4/tvguard/state ]; then
        state_src=/mnt/mmcblk2p4/tvguard/state
    fi
    [ -z "$state_src" ] || atomic_copy "$state_src" "$UPGRADE/state"

    # The standalone Bridge deliberately kept this key on uninstall. Keep an
    # extra RAM copy as a belt-and-suspenders guard against package transition.
    [ ! -f /etc/tvguard/agent-bridge.key ] ||
        atomic_copy /etc/tvguard/agent-bridge.key "$UPGRADE/agent-bridge.key"

    printf '%s\n' "$(date +%s 2>/dev/null || echo 0)" > "$PENDING"
    chmod 600 "$PENDING"

    # Keep the existing durable configuration backup as a second recovery path.
    if [ -x /usr/libexec/tvguard-data ]; then
        /usr/libexec/tvguard-data backup-config >/dev/null 2>&1 || :
    fi
else
    : > "$MARK"
    chmod 600 "$MARK"
fi

exit 0
