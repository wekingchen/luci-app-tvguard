#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    /usr/libexec/tvguard-data prepare || return 1
    /usr/libexec/tvguard-data config-sync >/dev/null 2>&1 ||
        logger -t tvguard "UCI config persistence sync failed; continuing with live config"
    /usr/libexec/tvguardctl sync || return 1
    procd_open_instance
    procd_set_param command /usr/libexec/tvguardd
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    # Persist committed UCI changes before refreshing TV Guard state. This
    # never restarts the global firewall or other proxy services.
    /usr/libexec/tvguard-data config-sync >/dev/null 2>&1 ||
        logger -t tvguard "UCI config backup failed during reload"
    /usr/libexec/tvguardctl sync
}

service_triggers() {
    # Deliberately do NOT subscribe to the global "firewall" config trigger.
    # fw3 invokes our isolated script include when it rebuilds its tables.
    procd_add_reload_trigger tvguard
}

stop_service() {
    # Stop service without silently changing an enforced policy.
    :
}
