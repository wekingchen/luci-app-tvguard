#!/bin/sh /etc/rc.common
# 独立于家长遥控 uhttpd 的 procd 巡检实例。只能重启 tvguard-remote。
# 即使独立 uhttpd 进程存活但 HTTP 假死，也能发现并尝试恢复。
START=98
STOP=11
USE_PROCD=1

start_service() {
    [ -x /usr/libexec/tvguard-remote-watchdog ] || return 1
    procd_open_instance
    procd_set_param command /usr/libexec/tvguard-remote-watchdog run
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}
