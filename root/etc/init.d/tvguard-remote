#!/bin/sh /etc/rc.common
# 默认不启用。独立 uhttpd 实例不得共享 LuCI 文档根目录。
START=97
STOP=12
USE_PROCD=1
start_service() {
    [ -f /etc/tvguard/remote-enabled ] || return 0
    [ "$(cat /etc/tvguard/remote-enabled)" = 1 ] || return 0
    [ -x /usr/sbin/uhttpd ] || return 1
    [ -x /usr/share/tvguard-remote/www/cgi-bin/tvg ] || return 1
    procd_open_instance
    procd_set_param command /usr/sbin/uhttpd -f -D -S \
        -h /usr/share/tvguard-remote/www \
        -x /cgi-bin -p 127.0.0.1:18765 -t 15 -n 5
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}
