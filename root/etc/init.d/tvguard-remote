#!/bin/sh /etc/rc.common
# 独立家长遥控 uhttpd。LAN 地址可能在 rcS START=97 后才由 netifd 配齐。
# 任何时候都不能因为 br-lan 尚未有私有 IPv4 而丢失回环监听。
START=97
STOP=12
USE_PROCD=1

start_service() {
    [ -f /etc/tvguard/remote-enabled ] || return 0
    [ "$(cat /etc/tvguard/remote-enabled)" = 1 ] || return 0
    [ -x /usr/sbin/uhttpd ] || return 1
    [ -x /usr/share/tvguard-remote/www/cgi-bin/tvg ] || return 1

    lan_ip=''
    if [ -f /etc/tvguard/remote-lan-enabled ] &&
       [ "$(cat /etc/tvguard/remote-lan-enabled)" = 1 ]; then
        # Network initialization may lag behind rcS. Bounded retries reduce
        # cold-boot races without hanging the service indefinitely if br-lan
        # is deliberately down. An interface.up/update trigger rechecks later.
        attempt=0
        while [ "$attempt" -lt 10 ]; do
            lan_ip="$(/usr/libexec/tvguard-remote-lan-ip 2>/dev/null || :)"
            [ -z "$lan_ip" ] || break
            attempt=$((attempt + 1))
            sleep 1
        done
        if [ -z "$lan_ip" ]; then
            logger -t tvguard-remote "br-lan IPv4 未就绪；暂只绑定 127.0.0.1，等待 LAN 网络事件恢复监听"
        fi
    fi

    procd_open_instance
    procd_set_param command /usr/sbin/uhttpd -f -D -S \
        -h /usr/share/tvguard-remote/www \
        -x /cgi-bin -p 127.0.0.1:18765 -t 15 -n 5
    # Never bind 0.0.0.0. If br-lan was not ready, loopback remains usable
    # by Cloudflare Tunnel; netifd event will restart with the LAN IP.
    if [ -n "$lan_ip" ]; then
        procd_append_param command -p "$lan_ip:18765"
    fi
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    # Link events can arrive after START=97; rebind only when a LAN address
    # might become available/changed. No global firewall/network reload.
    [ -f /etc/tvguard/remote-enabled ] &&
        [ "$(cat /etc/tvguard/remote-enabled)" = 1 ] || return 0
    [ -f /etc/tvguard/remote-lan-enabled ] &&
        [ "$(cat /etc/tvguard/remote-lan-enabled)" = 1 ] || return 0
    procd_open_trigger
    procd_add_interface_trigger "interface.up" "lan" /etc/init.d/tvguard-remote restart
    procd_add_interface_trigger "interface.update" "lan" /etc/init.d/tvguard-remote restart
    procd_close_trigger
}
