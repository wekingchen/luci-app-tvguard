#!/bin/sh
# TV Guard shadow-only network fingerprint suggestion.
# This program NEVER changes quota, modes or firewall policy.
# Usage: tvguard-shadow PPS TCP_PPS UDP_PPS BYTES_PER_S
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
CSV=/etc/tvguard/calibration-v3.csv
for n in "$@"; do
    case "$n" in ''|*[!0-9]*) echo 'unknown none 0'; exit 0 ;; esac
done
[ "$#" -eq 4 ] && [ -s "$CSV" ] || { echo 'unknown none 0'; exit 0; }
awk -F, -v p="$1" -v t="$2" -v u="$3" -v b="$4" '
function abs(v) { return v<0?-v:v }
function max(a,b) { return a>b?a:b }
$3 ~ /^(playing|paused|app_home|system_home|sleep)$/ &&
$4 ~ /^(general|tencent|iqiyi|mango|other|system)$/ &&
$5 ~ /^[0-9]+$/ && $6 ~ /^[0-9]+$/ && $7 ~ /^[0-9]+$/ &&
$8 ~ /^[0-9]+$/ {
    k=$3 SUBSEP $4
    n[k]++
    sp[k]+=$5; st[k]+=$6; su[k]+=$7; sb[k]+=$8
    sq[k]+=$5*$5
    sessions[k SUBSEP $2]=1
}
END {
    best=1e10; second=1e10; bestKey=""; eligible=0
    for (key in sessions) {
        split(key,fields,SUBSEP)
        k=fields[1] SUBSEP fields[2]
        nSessions[k]++
    }
    for (k in n) {
        # At least 3 independent 120-second calibrations per scene/app.
        if (n[k]<18 || nSessions[k]<3) continue
        ap=sp[k]/n[k]; at=st[k]/n[k]; au=su[k]/n[k]; ab=sb[k]/n[k]
        variance=sq[k]/n[k]-ap*ap
        if (variance<0) variance=0
        if (sqrt(variance)/max(20,ap)>0.70) continue
        eligible++
        # Normalized distances: source packet frequency matters most.
        d=abs(p-ap)/max(20,ap)
        d+=0.45*abs(t-at)/max(5,at)
        d+=0.45*abs(u-au)/max(5,au)
        d+=0.10*abs(b-ab)/max(1000,ab)
        if (d<best) {
            second=best
            best=d
            bestKey=k
        }
        else if (d<second) second=d
    }
    # No confident assignment from just one prototype or overlapping samples.
    if (eligible<2 || best>=0.50 || second-best<0.30) {
        print "unknown none 0"
        exit
    }
    split(bestKey,parts,SUBSEP)
    printf "%s %s %d\n",parts[1],parts[2],int((1-best/0.50)*100)
}' "$CSV"
