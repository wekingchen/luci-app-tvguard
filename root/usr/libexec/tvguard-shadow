#!/bin/sh
# App-agnostic, conservative network activity hint for TV Guard.
# Never affects counting, firewall or permissions. Unknown means "no proof".
# The 4 metrics are TV -> N1 outbound packets, NOT full video download traffic.
# Usage: tvguard-shadow PPS TCP_PPS UDP_PPS OUTBOUND_BYTES_PER_S
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
CSV=/etc/tvguard/calibration-v3.csv

[ "$#" -eq 4 ] || { echo 'unknown none 0'; exit 0; }
for number in "$@"; do
    case "$number" in ''|*[!0-9]*) echo 'unknown none 0'; exit 0;; esac
done
[ -s "$CSV" ] || { echo 'unknown none 0'; exit 0; }

awk -F, -v p="$1" -v t="$2" -v u="$3" -v b="$4" '
function low(a,b) { return a < b ? a : b }
function high(a,b) { return a > b ? a : b }
function ready_sessions(label) {
    return samples[label]>=18 && sess_n[label]>=3
}
function ready_cross_app(label) {
    return ready_sessions(label) && app_n[label]>=2
}
function playback_reference_ready() {
    # For device-local idle safety, playback is only a negative overlap
    # reference. One real labelled playback session with >=6 windows is enough
    # to reject obvious overlap; the exempted class still needs its own evidence.
    return samples["playing"]>=6 && sess_n["playing"]>=1
}
function local_app_home_ready() {
    # A manually labelled App-home session is useful on this TV even before
    # cross-App generalization is proven. Require enough windows to avoid a
    # one-off transition sample; unknown Apps that do not match remain charged.
    return samples["app_home"]>=10 && sess_n["app_home"]>=1
}
function local_pause_reference_ready() {
    # Pause is never granted a local exemption from one session because it
    # overlaps playback, but even one labelled pause session is useful as a
    # negative reference for deciding whether a sample is clearly playback.
    return samples["paused"]>=6 && sess_n["paused"]>=1
}
function inside(label) {
    return p>=pmin[label]-5 && p<=pmax[label]+5 &&
           t>=tmin[label]-3 && t<=tmax[label]+3 &&
           u>=umin[label]-5 && u<=umax[label]+5 &&
           b>=bmin[label]-4096 && b<=bmax[label]+4096
}
function inside_system_home_robust() {
    # The launcher produces occasional TCP/byte bursts while visually idle.
    # Keep PPS itself inside the low-activity home envelope, then accept one
    # noisy secondary dimension. This is stricter than a generic low-PPS rule:
    # it still needs 3/4 calibrated feature matches plus playback separation.
    hits=0
    if (p>=pmin["system_home"]-5 && p<=pmax["system_home"]+5) hits++
    if (t>=tmin["system_home"]-4 && t<=tmax["system_home"]+4) hits++
    if (u>=umin["system_home"]-5 && u<=umax["system_home"]+5) hits++
    if (b>=bmin["system_home"]-4096 && b<=bmax["system_home"]+8192) hits++
    return p<=pmax["system_home"]+5 && hits>=3
}
function separated_from(label) {
    return p<pmin[label]-10 || p>pmax[label]+10 ||
           t<tmin[label]-5 || t>tmax[label]+5 ||
           u<umin[label]-10 || u>umax[label]+10 ||
           b<bmin[label]-10240 || b>bmax[label]+10240
}
function clear_local_playing() {
    # "playing" is informational and never grants free time. Therefore it can
    # use a lower evidence threshold than idle, but it still must be clearly
    # outside every available idle/pause reference. Ambiguous overlap remains
    # unknown and continues billing.
    if (!playback_reference_ready()) return 0
    if (local_app_home_ready() && !separated_from("app_home")) return 0
    if (ready_sessions("system_home") && !separated_from("system_home")) return 0
    if (local_pause_reference_ready() && !separated_from("paused")) return 0

    # A point inside the labelled playback envelope is enough once all
    # conflicting references have been excluded.
    if (inside("playing")) return 1

    # Playback can burst above the small labelled sample. Accept that only
    # when activity is clearly beyond every local pause/home ceiling.
    if (local_pause_reference_ready() &&
        p>pmax["paused"]+20 &&
        (!local_app_home_ready() || p>pmax["app_home"]+20) &&
        (!ready_sessions("system_home") || p>pmax["system_home"]+20))
        return 1

    return 0
}
$2 ~ /^[0-9]+-[0-9]+$/ &&
$3 ~ /^(playing|paused|app_home|system_home|sleep)$/ &&
$4 ~ /^(general|tencent|iqiyi|mango|other|system)$/ &&
$5 ~ /^[0-9]+$/ && $6 ~ /^[0-9]+$/ &&
$7 ~ /^[0-9]+$/ && $8 ~ /^[0-9]+$/ {
    label=$3
    # Zero traffic alone cannot prove sleep/path integrity.
    if (label=="sleep") next
    if (label=="system_home" && $4!="system") next
    if (label!="system_home" && $4=="system") next

    samples[label]++
    if (samples[label]==1) {
        pmin[label]=pmax[label]=$5
        tmin[label]=tmax[label]=$6
        umin[label]=umax[label]=$7
        bmin[label]=bmax[label]=$8
    } else {
        pmin[label]=low(pmin[label],$5); pmax[label]=high(pmax[label],$5)
        tmin[label]=low(tmin[label],$6); tmax[label]=high(tmax[label],$6)
        umin[label]=low(umin[label],$7); umax[label]=high(umax[label],$7)
        bmin[label]=low(bmin[label],$8); bmax[label]=high(bmax[label],$8)
    }
    session_seen[label SUBSEP $2]=1
    if ($4=="tencent" || $4=="iqiyi" || $4=="mango")
        app_seen[label SUBSEP $4]=1
}
END {
    for (k in session_seen) {
        split(k,parts,SUBSEP)
        sess_n[parts[1]]++
    }
    for (k in app_seen) {
        split(k,parts,SUBSEP)
        app_n[parts[1]]++
    }

    # The Xiaomi system launcher is a device-level state. It may be learned
    # from repeated system-home sessions without pretending we know the app,
    # but it is exempted only when it is clearly outside an observed playback
    # envelope. This fixes the "sitting on TV home still consumes quota" case
    # without making a generic low-PPS exemption.
    # If two independently safe idle envelopes overlap, we know the TV is
    # idle but cannot honestly claim which home screen is foreground. Emit a
    # neutral idle label instead of whichever rule happens to run first.
    if (ready_sessions("system_home") && local_app_home_ready() &&
        playback_reference_ready() &&
        inside_system_home_robust() && inside("app_home") &&
        separated_from("playing")) {
        print "idle general 95"
        exit
    }

    if (ready_sessions("system_home") && playback_reference_ready() &&
        inside_system_home_robust() && separated_from("playing")) {
        print "system_home system 100"
        exit
    }

    # App-home and pause are both non-watching states for billing. They need
    # not be distinguishable from each other. Generic idle is allowed only
    # after cross-app evidence for playing + both idle classes, and the live
    # point must still be conservatively separated from playback.
    if (ready_cross_app("playing") && ready_cross_app("paused") &&
        ready_cross_app("app_home") &&
        (inside("paused") || inside("app_home")) &&
        separated_from("playing")) {
        print "idle general 100"
        exit
    }

    # Before cross-App generalization is ready, reuse a sufficiently long
    # manually labelled App-home session as a device-local idle fingerprint.
    # It must match the App-home envelope across all metrics AND be clearly
    # outside the observed playback envelope. This never turns arbitrary low
    # PPS into free time; non-matching/unknown states continue to charge.
    if (local_app_home_ready() && playback_reference_ready() &&
        inside("app_home") && separated_from("playing")) {
        print "app_home general 90"
        exit
    }

    # Preserve the higher-confidence cross-App playing hint when that
    # stronger evidence exists. This remains informational and billable.
    if (ready_cross_app("playing") && inside("playing") &&
        (!ready_cross_app("paused") || separated_from("paused")) &&
        (!ready_cross_app("app_home") || separated_from("app_home"))) {
        print "playing general 100"
        exit
    }

    # A playing hint is informational only; unknown also charges. Use local
    # labelled playback as soon as it is clearly separated from pause/home,
    # while keeping ambiguous overlap as unknown.
    if (clear_local_playing()) {
        print "playing general 95"
        exit
    }

    print "unknown none 0"
}' "$CSV"
