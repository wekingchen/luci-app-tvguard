#!/bin/sh
# App-agnostic, conservative network activity hint for TV Guard.
# Never affects counting, firewall or permissions. Unknown means "no proof".
# The 4 metrics are TV -> N1 outbound packets, NOT full video download traffic.
# Usage: tvguard-shadow PPS TCP_PPS UDP_PPS OUTBOUND_BYTES_PER_S
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
CSV=/etc/tvguard/calibration-v3.csv

[ "$#" -eq 4 ] || { echo 'unknown none 0'; exit 0; }
for number in "$@"; do
    case "$number" in ''|*[!0-9]*) echo 'unknown none 0'; exit 0;; esac
done
[ -s "$CSV" ] || { echo 'unknown none 0'; exit 0; }

awk -F, -v p="$1" -v t="$2" -v u="$3" -v b="$4" '
function low(a,b) { return a < b ? a : b }
function high(a,b) { return a > b ? a : b }
function ready_sessions(label) {
    return samples[label]>=18 && sess_n[label]>=3
}
function ready_cross_app(label) {
    return ready_sessions(label) && app_n[label]>=2
}
function inside(label) {
    return p>=pmin[label]-5 && p<=pmax[label]+5 &&
           t>=tmin[label]-3 && t<=tmax[label]+3 &&
           u>=umin[label]-5 && u<=umax[label]+5 &&
           b>=bmin[label]-4096 && b<=bmax[label]+4096
}
function separated_from(label) {
    return p<pmin[label]-10 || p>pmax[label]+10 ||
           t<tmin[label]-5 || t>tmax[label]+5 ||
           u<umin[label]-10 || u>umax[label]+10 ||
           b<bmin[label]-10240 || b>bmax[label]+10240
}
$2 ~ /^[0-9]+-[0-9]+$/ &&
$3 ~ /^(playing|paused|app_home|system_home|sleep)$/ &&
$4 ~ /^(general|tencent|iqiyi|mango|other|system)$/ &&
$5 ~ /^[0-9]+$/ && $6 ~ /^[0-9]+$/ &&
$7 ~ /^[0-9]+$/ && $8 ~ /^[0-9]+$/ {
    label=$3
    # Zero traffic alone cannot prove sleep/path integrity.
    if (label=="sleep") next
    if (label=="system_home" && $4!="system") next
    if (label!="system_home" && $4=="system") next

    samples[label]++
    if (samples[label]==1) {
        pmin[label]=pmax[label]=$5
        tmin[label]=tmax[label]=$6
        umin[label]=umax[label]=$7
        bmin[label]=bmax[label]=$8
    } else {
        pmin[label]=low(pmin[label],$5); pmax[label]=high(pmax[label],$5)
        tmin[label]=low(tmin[label],$6); tmax[label]=high(tmax[label],$6)
        umin[label]=low(umin[label],$7); umax[label]=high(umax[label],$7)
        bmin[label]=low(bmin[label],$8); bmax[label]=high(bmax[label],$8)
    }
    session_seen[label SUBSEP $2]=1
    if ($4=="tencent" || $4=="iqiyi" || $4=="mango")
        app_seen[label SUBSEP $4]=1
}
END {
    for (k in session_seen) {
        split(k,parts,SUBSEP)
        sess_n[parts[1]]++
    }
    for (k in app_seen) {
        split(k,parts,SUBSEP)
        app_n[parts[1]]++
    }

    # The Xiaomi system launcher is a device-level state. It may be learned
    # from repeated system-home sessions without pretending we know the app,
    # but it is exempted only when it is clearly outside an observed playback
    # envelope. This fixes the "sitting on TV home still consumes quota" case
    # without making a generic low-PPS exemption.
    if (ready_sessions("system_home") && ready_sessions("playing") &&
        inside("system_home") && separated_from("playing")) {
        print "system_home system 100"
        exit
    }

    # App-home and pause are both non-watching states for billing. They need
    # not be distinguishable from each other. Generic idle is allowed only
    # after cross-app evidence for playing + both idle classes, and the live
    # point must still be conservatively separated from playback.
    if (ready_cross_app("playing") && ready_cross_app("paused") &&
        ready_cross_app("app_home") &&
        (inside("paused") || inside("app_home")) &&
        separated_from("playing")) {
        print "idle general 100"
        exit
    }

    # A playing hint is informational only; unknown also charges, so an
    # uncertain sample can never become a billing exemption.
    if (ready_cross_app("playing") && inside("playing") &&
        (!ready_cross_app("paused") || separated_from("paused")) &&
        (!ready_cross_app("app_home") || separated_from("app_home"))) {
        print "playing general 100"
        exit
    }

    print "unknown none 0"
}' "$CSV"
