#!/bin/sh
# 远程端状态白名单，只输出手机需要的固定字段；不转发 Agent/网络诊断数据。
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
command -v jsonfilter >/dev/null 2>&1 || exit 1
raw="$(/usr/libexec/tvguard-status status)" || exit 1
[ -n "$raw" ] || exit 1
field() {
    v="$(jsonfilter -s "$raw" -e "@.$1" 2>/dev/null)" || exit 1
    case "$v" in ''|*[!a-zA-Z0-9._]*) exit 1 ;; esac
    printf '%s' "$v"
}
number() {
    v="$(field "$1")" || exit 1
    case "$v" in ''|*[!0-9]*) exit 1 ;; esac
    [ "$(printf '%s' "$v" | wc -c)" -le 15 ] || exit 1
    printf '%s' "$v"
}
mode="$(field mode)" || exit 1
case "$mode" in child|parent|locked) : ;; *) exit 1 ;; esac
watch="$(number watch_seconds)" || exit 1
remaining="$(number remaining_seconds)" || exit 1
quota="$(number quota_seconds)" || exit 1
bonus="$(number bonus_seconds)" || exit 1
bonus_limit="$(number bonus_limit_seconds)" || exit 1
undo="$(number bonus_undo_available)" || exit 1
enforce="$(number enforce)" || exit 1
blocked="$(number blocked)" || exit 1
for bit in "$undo" "$enforce" "$blocked"; do
    case "$bit" in 0|1) : ;; *) exit 1 ;; esac
done
printf '{"mode":"%s","watch_seconds":%s,"remaining_seconds":%s,"quota_seconds":%s,"bonus_seconds":%s,"bonus_limit_seconds":%s,"bonus_undo_available":%s,"enforce":%s,"blocked":%s}\n' \
    "$mode" "$watch" "$remaining" "$quota" "$bonus" "$bonus_limit" "$undo" "$enforce" "$blocked"
