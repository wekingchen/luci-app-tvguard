#!/bin/sh
# TV Guard Shadow Soak observer v2.
# Raw 10-second telemetry stays in /var/run. Persistent summary writes happen
# only on overlap-candidate transitions or at most once per hour.
set -eu
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

DATA=/usr/libexec/tvguard-data
DIR="$("$DATA" root)"
PERSIST_DIR="$("$DATA" persistent-root)"
RING=/var/run/tvguard-soak-window.csv
STATE=/var/run/tvguard-soak.state
SCHEMA_FILE=/var/run/tvguard-soak-schema
SUMMARY="$PERSIST_DIR/soak-summary"
MAX_LINES=2160
TRIM_AT=2200
CHECKPOINT_S=3600
SCHEMA=v2

[ "$#" -eq 17 ] || {
    echo "usage: tvguard-soak EPOCH MODE ADAPTIVE_STATE ADAPTIVE_SCORE PAUSE_HINT PAUSE_SCORE PPS TCP_PPS UDP_PPS BPS P50 P90 BP50 BP90 ACTIVE_HITS TREND SHADOW_LABEL" >&2
    exit 2
}

NOW="$1"; MODE="$2"; ADAPTIVE_STATE="$3"; ADAPTIVE_SCORE="$4"
PAUSE_HINT="$5"; PAUSE_SCORE="$6"; PPS="$7"; TCP_PPS="$8"
shift 8
UDP_PPS="$1"; BPS="$2"; P50="$3"; P90="$4"; BP50="$5"; BP90="$6"; ACTIVE_HITS="$7"; TREND="$8"; SHADOW_LABEL="$9"

for n in "$NOW" "$ADAPTIVE_SCORE" "$PAUSE_SCORE" "$PPS" "$TCP_PPS" "$UDP_PPS" "$BPS" "$P50" "$P90" "$BP50" "$BP90" "$ACTIVE_HITS"; do
    case "$n" in ''|*[!0-9]*) exit 2;; esac
done
case "$TREND" in -[0-9]*|[0-9]*) :;; *) exit 2;; esac
case "$MODE" in child|parent|locked) :;; *) MODE=unknown;; esac
case "$ADAPTIVE_STATE" in unready|warming|idle|active|ambiguous) :;; *) ADAPTIVE_STATE=unready;; esac
case "$PAUSE_HINT" in none|idle_overlap|bursty_pause|high_ratio_pause) :;; *) PAUSE_HINT=none;; esac
case "$SHADOW_LABEL" in playing|idle|paused|app_home|system_home|sleep|unknown) :;; *) SHADOW_LABEL=unknown;; esac

if [ ! -r "$SCHEMA_FILE" ] || [ "$(cat "$SCHEMA_FILE" 2>/dev/null || :)" != "$SCHEMA" ]; then
    rm -f "$RING"
    printf '%s\n' "$SCHEMA" > "$SCHEMA_FILE"
    chmod 600 "$SCHEMA_FILE"
fi

printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
    "$NOW" "$MODE" "$ADAPTIVE_STATE" "$ADAPTIVE_SCORE" "$PAUSE_HINT" "$PAUSE_SCORE" \
    "$PPS" "$TCP_PPS" "$UDP_PPS" "$BPS" "$P50" "$P90" "$BP50" "$BP90" "$ACTIVE_HITS" "$TREND" "$SHADOW_LABEL" >> "$RING"
lines="$(wc -l < "$RING" 2>/dev/null || echo 0)"
case "$lines" in ''|*[!0-9]*) lines=0;; esac
if [ "$lines" -gt "$TRIM_AT" ]; then
    tail -n "$MAX_LINES" "$RING" > "$RING.$$"
    chmod 600 "$RING.$$"
    mv -f "$RING.$$" "$RING"
fi

LAST_HINT=none
CANDIDATE_START=0
CANDIDATE_SAMPLES=0
CANDIDATE_MAX_SCORE=0
CANDIDATE_MAX_BP50=0
CANDIDATE_MAX_BP90=0
CANDIDATE_ACTIVE_SAMPLES=0
CANDIDATE_AMBIGUOUS_SAMPLES=0
CANDIDATE_TCP_SUM=0
CANDIDATE_UDP_SUM=0
CANDIDATE_BPS_SUM=0
TOTAL_SAMPLES=0
HIGH_RATIO_SAMPLES=0
HIGH_RATIO_ENTERS=0
HIGH_RATIO_EXITS=0
HIGH_RATIO_SECONDS=0
MAX_HIGH_RATIO_SECONDS=0
HIGH_RATIO_TCP_SUM=0
HIGH_RATIO_UDP_SUM=0
HIGH_RATIO_BPS_SUM=0
LAST_SESSION_DURATION=0
LAST_SESSION_SAMPLES=0
LAST_SESSION_ACTIVE_SAMPLES=0
LAST_SESSION_AMBIGUOUS_SAMPLES=0
LAST_SESSION_MAX_SCORE=0
LAST_SESSION_MAX_BP50=0
LAST_SESSION_MAX_BP90=0
LAST_SESSION_TCP_SUM=0
LAST_SESSION_UDP_SUM=0
LAST_SESSION_BPS_SUM=0
CHECKPOINT_EPOCH=0
LAST_TRANSITION_EPOCH=0
LAST_TRANSITION=none
LAST_EPOCH=0
LAST_MODE=unknown
LAST_ADAPTIVE_STATE=unready
LAST_ADAPTIVE_SCORE=0
LAST_PAUSE_HINT=none
LAST_PAUSE_SCORE=0
LAST_PPS=0
LAST_TCP_PPS=0
LAST_UDP_PPS=0
LAST_BPS=0
LAST_P50=0
LAST_P90=0
LAST_BP50=0
LAST_BP90=0
LAST_ACTIVE_HITS=0
LAST_TREND=0
LAST_SHADOW_LABEL=unknown
TEMPORAL_HINT=none
TEMPORAL_SCORE=0
TEMPORAL_WINDOWS=0
TEMPORAL_P10=0
TEMPORAL_P50=0
TEMPORAL_P90=0
TEMPORAL_SPREAD=0
TEMPORAL_MAX=0
TEMPORAL_LAST_HINT=none
TEMPORAL_CANDIDATE_START=0
TEMPORAL_CANDIDATE_SAMPLES=0
TEMPORAL_ENTERS=0
TEMPORAL_EXITS=0
TEMPORAL_SECONDS=0
TEMPORAL_MAX_SECONDS=0
TEMPORAL_LAST_DURATION=0
SOAK_SCHEMA=v1

if [ -r "$STATE" ]; then
    . "$STATE"
elif [ "$DIR" = "$PERSIST_DIR" ] && [ -r "$SUMMARY" ]; then
    . "$SUMMARY"
fi

# r10 summaries did not contain protocol/throughput fields. Mixing those old
# counters with v2 sums would corrupt averages, so start a clean v2 evidence
# epoch while keeping the r10 false-positive result in docs/events.log.
if [ "$SOAK_SCHEMA" != "$SCHEMA" ]; then
    LAST_HINT=none
    CANDIDATE_START=0
    CANDIDATE_SAMPLES=0
    CANDIDATE_MAX_SCORE=0
    CANDIDATE_MAX_BP50=0
    CANDIDATE_MAX_BP90=0
    CANDIDATE_ACTIVE_SAMPLES=0
    CANDIDATE_AMBIGUOUS_SAMPLES=0
    CANDIDATE_TCP_SUM=0
    CANDIDATE_UDP_SUM=0
    CANDIDATE_BPS_SUM=0
    TOTAL_SAMPLES=0
    HIGH_RATIO_SAMPLES=0
    HIGH_RATIO_ENTERS=0
    HIGH_RATIO_EXITS=0
    HIGH_RATIO_SECONDS=0
    MAX_HIGH_RATIO_SECONDS=0
    HIGH_RATIO_TCP_SUM=0
    HIGH_RATIO_UDP_SUM=0
    HIGH_RATIO_BPS_SUM=0
    LAST_SESSION_DURATION=0
    LAST_SESSION_SAMPLES=0
    LAST_SESSION_ACTIVE_SAMPLES=0
    LAST_SESSION_AMBIGUOUS_SAMPLES=0
    LAST_SESSION_MAX_SCORE=0
    LAST_SESSION_MAX_BP50=0
    LAST_SESSION_MAX_BP90=0
    LAST_SESSION_TCP_SUM=0
    LAST_SESSION_UDP_SUM=0
    LAST_SESSION_BPS_SUM=0
    CHECKPOINT_EPOCH=0
    LAST_TRANSITION_EPOCH=0
    LAST_TRANSITION=none
    SOAK_SCHEMA="$SCHEMA"
fi

for n in CANDIDATE_START CANDIDATE_SAMPLES CANDIDATE_MAX_SCORE CANDIDATE_MAX_BP50 CANDIDATE_MAX_BP90 \
         CANDIDATE_ACTIVE_SAMPLES CANDIDATE_AMBIGUOUS_SAMPLES CANDIDATE_TCP_SUM CANDIDATE_UDP_SUM CANDIDATE_BPS_SUM \
         TOTAL_SAMPLES HIGH_RATIO_SAMPLES HIGH_RATIO_ENTERS HIGH_RATIO_EXITS HIGH_RATIO_SECONDS MAX_HIGH_RATIO_SECONDS \
         HIGH_RATIO_TCP_SUM HIGH_RATIO_UDP_SUM HIGH_RATIO_BPS_SUM LAST_SESSION_DURATION LAST_SESSION_SAMPLES \
         LAST_SESSION_ACTIVE_SAMPLES LAST_SESSION_AMBIGUOUS_SAMPLES LAST_SESSION_MAX_SCORE LAST_SESSION_MAX_BP50 \
         LAST_SESSION_MAX_BP90 LAST_SESSION_TCP_SUM LAST_SESSION_UDP_SUM LAST_SESSION_BPS_SUM CHECKPOINT_EPOCH LAST_TRANSITION_EPOCH; do
    eval "v=\$$n"
    case "$v" in ''|*[!0-9]*) eval "$n=0";; esac
done
case "$LAST_HINT" in none|idle_overlap|bursty_pause|high_ratio_pause) :;; *) LAST_HINT=none;; esac
case "$LAST_TRANSITION" in none|enter|exit|checkpoint) :;; *) LAST_TRANSITION=none;; esac
case "$TEMPORAL_LAST_HINT" in none|stable_low_plateau) :;; *) TEMPORAL_LAST_HINT=none;; esac
for n in TEMPORAL_SCORE TEMPORAL_WINDOWS TEMPORAL_P10 TEMPORAL_P50 TEMPORAL_P90 TEMPORAL_SPREAD TEMPORAL_MAX          TEMPORAL_CANDIDATE_START TEMPORAL_CANDIDATE_SAMPLES TEMPORAL_ENTERS TEMPORAL_EXITS TEMPORAL_SECONDS          TEMPORAL_MAX_SECONDS TEMPORAL_LAST_DURATION; do
    eval "v=\$n"
    case "$v" in ''|*[!0-9]*) eval "$n=0";; esac
done

# P1-C diagnostic only: look for a very narrow low-PPS plateau over about
# two minutes. This is deliberately conservative and has NO billing authority.
# Real N1 field regressions must prove that low-bitrate playback does not
# trigger it before any future authorization is considered.
TEMPORAL_HINT=none
TEMPORAL_SCORE=0
TEMPORAL_WINDOWS=0
TEMPORAL_P10=0
TEMPORAL_P50=0
TEMPORAL_P90=0
TEMPORAL_SPREAD=0
TEMPORAL_MAX=0
temporal_recent="${RING}.temporal.$"
tail -n 12 "$RING" > "$temporal_recent" 2>/dev/null || :
temporal_calc="$(awk -F, '
function sortarr(a,n,    i,j,x) {
    for (i=2;i<=n;i++) {
        x=a[i]; j=i-1
        while (j>=1 && a[j]>x) { a[j+1]=a[j]; j-- }
        a[j+1]=x
    }
}
function q(a,n,num,den,    idx) {
    idx=int((n*num + den - 1)/den)
    if (idx<1) idx=1
    if (idx>n) idx=n
    return a[idx]
}
{
    n++
    p[n]=$7+0
    if (n==1 || p[n]>mx) mx=p[n]
}
END {
    if (n<1) { print "0 0 0 0 0"; exit }
    sortarr(p,n)
    p10=q(p,n,1,10); p50=q(p,n,1,2); p90=q(p,n,9,10)
    printf "%d %d %d %d %d\n", n,p10,p50,p90,mx
}' "$temporal_recent")"
rm -f "$temporal_recent"
set -- $temporal_calc
TEMPORAL_WINDOWS="$1"; TEMPORAL_P10="$2"; TEMPORAL_P50="$3"; TEMPORAL_P90="$4"; TEMPORAL_MAX="$5"
TEMPORAL_SPREAD=$((TEMPORAL_P90 - TEMPORAL_P10))
[ "$TEMPORAL_SPREAD" -ge 0 ] || TEMPORAL_SPREAD=0
if [ "$TEMPORAL_WINDOWS" -ge 12 ] &&
   [ "$TEMPORAL_P90" -le 20 ] &&
   [ "$TEMPORAL_SPREAD" -le 5 ] &&
   [ "$TEMPORAL_MAX" -le 25 ]; then
    TEMPORAL_HINT=stable_low_plateau
    TEMPORAL_SCORE=70
fi

TEMPORAL_TRANSITION=none
TEMPORAL_DURATION=0
if [ "$TEMPORAL_HINT" = stable_low_plateau ]; then
    if [ "$TEMPORAL_LAST_HINT" != stable_low_plateau ]; then
        TEMPORAL_CANDIDATE_START="$NOW"
        TEMPORAL_CANDIDATE_SAMPLES=0
        TEMPORAL_ENTERS=$((TEMPORAL_ENTERS + 1))
        TEMPORAL_TRANSITION=enter
    fi
    TEMPORAL_CANDIDATE_SAMPLES=$((TEMPORAL_CANDIDATE_SAMPLES + 1))
elif [ "$TEMPORAL_LAST_HINT" = stable_low_plateau ]; then
    TEMPORAL_DURATION=$((NOW - TEMPORAL_CANDIDATE_START))
    [ "$TEMPORAL_DURATION" -ge 0 ] || TEMPORAL_DURATION=0
    TEMPORAL_SECONDS=$((TEMPORAL_SECONDS + TEMPORAL_DURATION))
    [ "$TEMPORAL_DURATION" -le "$TEMPORAL_MAX_SECONDS" ] || TEMPORAL_MAX_SECONDS="$TEMPORAL_DURATION"
    TEMPORAL_LAST_DURATION="$TEMPORAL_DURATION"
    TEMPORAL_EXITS=$((TEMPORAL_EXITS + 1))
    TEMPORAL_TRANSITION=exit
fi
TEMPORAL_LAST_HINT="$TEMPORAL_HINT"

TOTAL_SAMPLES=$((TOTAL_SAMPLES + 1))
TRANSITION=none
DURATION=0

if [ "$PAUSE_HINT" = high_ratio_pause ]; then
    HIGH_RATIO_SAMPLES=$((HIGH_RATIO_SAMPLES + 1))
    if [ "$LAST_HINT" != high_ratio_pause ]; then
        CANDIDATE_START="$NOW"
        CANDIDATE_SAMPLES=0
        CANDIDATE_MAX_SCORE=0
        CANDIDATE_MAX_BP50=0
        CANDIDATE_MAX_BP90=0
        CANDIDATE_ACTIVE_SAMPLES=0
        CANDIDATE_AMBIGUOUS_SAMPLES=0
        CANDIDATE_TCP_SUM=0
        CANDIDATE_UDP_SUM=0
        CANDIDATE_BPS_SUM=0
        HIGH_RATIO_ENTERS=$((HIGH_RATIO_ENTERS + 1))
        TRANSITION=enter
    fi
    CANDIDATE_SAMPLES=$((CANDIDATE_SAMPLES + 1))
    [ "$PAUSE_SCORE" -le "$CANDIDATE_MAX_SCORE" ] || CANDIDATE_MAX_SCORE="$PAUSE_SCORE"
    [ "$BP50" -le "$CANDIDATE_MAX_BP50" ] || CANDIDATE_MAX_BP50="$BP50"
    [ "$BP90" -le "$CANDIDATE_MAX_BP90" ] || CANDIDATE_MAX_BP90="$BP90"
    CANDIDATE_TCP_SUM=$((CANDIDATE_TCP_SUM + TCP_PPS))
    CANDIDATE_UDP_SUM=$((CANDIDATE_UDP_SUM + UDP_PPS))
    CANDIDATE_BPS_SUM=$((CANDIDATE_BPS_SUM + BPS))
    HIGH_RATIO_TCP_SUM=$((HIGH_RATIO_TCP_SUM + TCP_PPS))
    HIGH_RATIO_UDP_SUM=$((HIGH_RATIO_UDP_SUM + UDP_PPS))
    HIGH_RATIO_BPS_SUM=$((HIGH_RATIO_BPS_SUM + BPS))
    [ "$ADAPTIVE_STATE" != active ] || CANDIDATE_ACTIVE_SAMPLES=$((CANDIDATE_ACTIVE_SAMPLES + 1))
    [ "$ADAPTIVE_STATE" != ambiguous ] || CANDIDATE_AMBIGUOUS_SAMPLES=$((CANDIDATE_AMBIGUOUS_SAMPLES + 1))
elif [ "$LAST_HINT" = high_ratio_pause ]; then
    DURATION=$((NOW - CANDIDATE_START))
    [ "$DURATION" -ge 0 ] || DURATION=0
    HIGH_RATIO_SECONDS=$((HIGH_RATIO_SECONDS + DURATION))
    [ "$DURATION" -le "$MAX_HIGH_RATIO_SECONDS" ] || MAX_HIGH_RATIO_SECONDS="$DURATION"
    LAST_SESSION_DURATION="$DURATION"
    LAST_SESSION_SAMPLES="$CANDIDATE_SAMPLES"
    LAST_SESSION_ACTIVE_SAMPLES="$CANDIDATE_ACTIVE_SAMPLES"
    LAST_SESSION_AMBIGUOUS_SAMPLES="$CANDIDATE_AMBIGUOUS_SAMPLES"
    LAST_SESSION_MAX_SCORE="$CANDIDATE_MAX_SCORE"
    LAST_SESSION_MAX_BP50="$CANDIDATE_MAX_BP50"
    LAST_SESSION_MAX_BP90="$CANDIDATE_MAX_BP90"
    LAST_SESSION_TCP_SUM="$CANDIDATE_TCP_SUM"
    LAST_SESSION_UDP_SUM="$CANDIDATE_UDP_SUM"
    LAST_SESSION_BPS_SUM="$CANDIDATE_BPS_SUM"
    HIGH_RATIO_EXITS=$((HIGH_RATIO_EXITS + 1))
    TRANSITION=exit
fi

LAST_HINT="$PAUSE_HINT"
LAST_EPOCH="$NOW"
LAST_MODE="$MODE"
LAST_ADAPTIVE_STATE="$ADAPTIVE_STATE"
LAST_ADAPTIVE_SCORE="$ADAPTIVE_SCORE"
LAST_PAUSE_HINT="$PAUSE_HINT"
LAST_PAUSE_SCORE="$PAUSE_SCORE"
LAST_PPS="$PPS"
LAST_TCP_PPS="$TCP_PPS"
LAST_UDP_PPS="$UDP_PPS"
LAST_BPS="$BPS"
LAST_P50="$P50"
LAST_P90="$P90"
LAST_BP50="$BP50"
LAST_BP90="$BP90"
LAST_ACTIVE_HITS="$ACTIVE_HITS"
LAST_TREND="$TREND"
LAST_SHADOW_LABEL="$SHADOW_LABEL"
if [ "$TRANSITION" != none ]; then
    LAST_TRANSITION_EPOCH="$NOW"
    LAST_TRANSITION="$TRANSITION"
fi

write_state() {
    target="$1"
    tmp="$target.$$"
    cat > "$tmp" <<EOF
SOAK_SCHEMA=$SCHEMA
LAST_HINT=$LAST_HINT
CANDIDATE_START=$CANDIDATE_START
CANDIDATE_SAMPLES=$CANDIDATE_SAMPLES
CANDIDATE_MAX_SCORE=$CANDIDATE_MAX_SCORE
CANDIDATE_MAX_BP50=$CANDIDATE_MAX_BP50
CANDIDATE_MAX_BP90=$CANDIDATE_MAX_BP90
CANDIDATE_ACTIVE_SAMPLES=$CANDIDATE_ACTIVE_SAMPLES
CANDIDATE_AMBIGUOUS_SAMPLES=$CANDIDATE_AMBIGUOUS_SAMPLES
CANDIDATE_TCP_SUM=$CANDIDATE_TCP_SUM
CANDIDATE_UDP_SUM=$CANDIDATE_UDP_SUM
CANDIDATE_BPS_SUM=$CANDIDATE_BPS_SUM
TOTAL_SAMPLES=$TOTAL_SAMPLES
HIGH_RATIO_SAMPLES=$HIGH_RATIO_SAMPLES
HIGH_RATIO_ENTERS=$HIGH_RATIO_ENTERS
HIGH_RATIO_EXITS=$HIGH_RATIO_EXITS
HIGH_RATIO_SECONDS=$HIGH_RATIO_SECONDS
MAX_HIGH_RATIO_SECONDS=$MAX_HIGH_RATIO_SECONDS
HIGH_RATIO_TCP_SUM=$HIGH_RATIO_TCP_SUM
HIGH_RATIO_UDP_SUM=$HIGH_RATIO_UDP_SUM
HIGH_RATIO_BPS_SUM=$HIGH_RATIO_BPS_SUM
LAST_SESSION_DURATION=$LAST_SESSION_DURATION
LAST_SESSION_SAMPLES=$LAST_SESSION_SAMPLES
LAST_SESSION_ACTIVE_SAMPLES=$LAST_SESSION_ACTIVE_SAMPLES
LAST_SESSION_AMBIGUOUS_SAMPLES=$LAST_SESSION_AMBIGUOUS_SAMPLES
LAST_SESSION_MAX_SCORE=$LAST_SESSION_MAX_SCORE
LAST_SESSION_MAX_BP50=$LAST_SESSION_MAX_BP50
LAST_SESSION_MAX_BP90=$LAST_SESSION_MAX_BP90
LAST_SESSION_TCP_SUM=$LAST_SESSION_TCP_SUM
LAST_SESSION_UDP_SUM=$LAST_SESSION_UDP_SUM
LAST_SESSION_BPS_SUM=$LAST_SESSION_BPS_SUM
CHECKPOINT_EPOCH=$CHECKPOINT_EPOCH
LAST_TRANSITION_EPOCH=$LAST_TRANSITION_EPOCH
LAST_TRANSITION=$LAST_TRANSITION
LAST_EPOCH=$LAST_EPOCH
LAST_MODE=$LAST_MODE
LAST_ADAPTIVE_STATE=$LAST_ADAPTIVE_STATE
LAST_ADAPTIVE_SCORE=$LAST_ADAPTIVE_SCORE
LAST_PAUSE_HINT=$LAST_PAUSE_HINT
LAST_PAUSE_SCORE=$LAST_PAUSE_SCORE
LAST_PPS=$LAST_PPS
LAST_TCP_PPS=$LAST_TCP_PPS
LAST_UDP_PPS=$LAST_UDP_PPS
LAST_BPS=$LAST_BPS
LAST_P50=$LAST_P50
LAST_P90=$LAST_P90
LAST_BP50=$LAST_BP50
LAST_BP90=$LAST_BP90
LAST_ACTIVE_HITS=$LAST_ACTIVE_HITS
LAST_TREND=$LAST_TREND
LAST_SHADOW_LABEL=$LAST_SHADOW_LABEL
TEMPORAL_HINT=$TEMPORAL_HINT
TEMPORAL_SCORE=$TEMPORAL_SCORE
TEMPORAL_WINDOWS=$TEMPORAL_WINDOWS
TEMPORAL_P10=$TEMPORAL_P10
TEMPORAL_P50=$TEMPORAL_P50
TEMPORAL_P90=$TEMPORAL_P90
TEMPORAL_SPREAD=$TEMPORAL_SPREAD
TEMPORAL_MAX=$TEMPORAL_MAX
TEMPORAL_LAST_HINT=$TEMPORAL_LAST_HINT
TEMPORAL_CANDIDATE_START=$TEMPORAL_CANDIDATE_START
TEMPORAL_CANDIDATE_SAMPLES=$TEMPORAL_CANDIDATE_SAMPLES
TEMPORAL_ENTERS=$TEMPORAL_ENTERS
TEMPORAL_EXITS=$TEMPORAL_EXITS
TEMPORAL_SECONDS=$TEMPORAL_SECONDS
TEMPORAL_MAX_SECONDS=$TEMPORAL_MAX_SECONDS
TEMPORAL_LAST_DURATION=$TEMPORAL_LAST_DURATION
EOF
    chmod 600 "$tmp"
    mv -f "$tmp" "$target"
}

write_state "$STATE"

PERSIST=0
if [ "$TRANSITION" != none ]; then
    PERSIST=1
elif [ "$CHECKPOINT_EPOCH" -eq 0 ] || [ $((NOW - CHECKPOINT_EPOCH)) -ge "$CHECKPOINT_S" ]; then
    PERSIST=1
    LAST_TRANSITION=checkpoint
fi
if [ "$PERSIST" -eq 1 ] && [ "$DIR" = "$PERSIST_DIR" ]; then
    CHECKPOINT_EPOCH="$NOW"
    mkdir -p "$PERSIST_DIR"
    write_state "$SUMMARY"
    write_state "$STATE"
fi

printf '%s %s %s %s %s %s %s %s\n' \
    "$TRANSITION" "$DURATION" "$HIGH_RATIO_ENTERS" "$HIGH_RATIO_EXITS" \
    "$HIGH_RATIO_SECONDS" "$MAX_HIGH_RATIO_SECONDS" "$TOTAL_SAMPLES" "$HIGH_RATIO_SAMPLES"
