#!/bin/sh
# Bounded-storage guard for TV Guard persistent append-only data.
# Normal runtime rolling windows live in /var/run and are not persistent.
set -eu
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

DIR=/etc/tvguard

trim_file() {
    file="$1"
    max_bytes="$2"
    keep_lines="$3"
    [ -f "$file" ] || return 0
    size="$(wc -c < "$file" 2>/dev/null || echo 0)"
    case "$size" in ''|*[!0-9]*) size=0;; esac
    [ "$size" -gt "$max_bytes" ] || return 0

    tmp="${file}.$$"
    tail -n "$keep_lines" "$file" > "$tmp"
    chmod 600 "$tmp"
    mv -f "$tmp" "$file"
}

trim_all() {
    mkdir -p "$DIR"
    # Hard design budget for append-only persistent data:
    # 256 KiB + 256 KiB + 384 KiB + 128 KiB = 1 MiB.
    trim_file "$DIR/events.log" 262144 1500
    trim_file "$DIR/calibration-v3.csv" 262144 1500
    trim_file "$DIR/calibration-v4.csv" 393216 1800
    trim_file "$DIR/learning-sessions.csv" 131072 512
}

bytes_of() {
    if [ -f "$1" ]; then
        wc -c < "$1" 2>/dev/null | tr -d ' '
    else
        echo 0
    fi
}

report() {
    events="$(bytes_of "$DIR/events.log")"
    v3="$(bytes_of "$DIR/calibration-v3.csv")"
    v4="$(bytes_of "$DIR/calibration-v4.csv")"
    sessions="$(bytes_of "$DIR/learning-sessions.csv")"
    last="$(bytes_of "$DIR/learning-last.txt")"
    state="$(bytes_of "$DIR/state")"
    total=$((events + v3 + v4 + sessions))
    small=$((last + state))

    free_kb="$(df -k "$DIR" 2>/dev/null | awk 'NR==2 {print $4; exit}')"
    case "$free_kb" in ''|*[!0-9]*) free_kb=unknown;; esac

    cat <<EOF
TV Guard 存储护栏
持久追加预算: 1048576 bytes (1 MiB)
当前追加数据: $total bytes
events.log: $events / 262144
calibration-v3.csv: $v3 / 262144
calibration-v4.csv: $v4 / 393216
learning-sessions.csv: $sessions / 131072
覆盖写小文件: $small bytes
文件系统可用: $free_kb KiB
Adaptive 滚动窗口: /var/run/tvguard-adaptive-window.csv（临时，最多约 12 行，不写入持久存储）
EOF
}

case "${1:-trim}" in
    trim) trim_all ;;
    report) report ;;
    *) exit 2 ;;
esac
