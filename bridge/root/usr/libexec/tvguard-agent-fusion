#!/bin/sh
# TVGuard v0.2.8 generic Agent/N1 temporal fusion.
# No video-app package names or per-app decision branches are allowed here.
# RAM-only observer: never edits quota, billing state, firewall or persistent data.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

RAM=/var/run/tvguard-agent-bridge
STATE="$RAM/fusion.state"
LOCK="$RAM/fusion.lock"

[ "$#" -eq 15 ] || {
    echo "unknown invalid_arguments 0"
    exit 0
}

now="$1"
seen="$2"
seq="$3"
pkg="$4"
activity="$5"
audio="$6"
screen="$7"
pps="$8"
shadow="$9"
shift 9
adaptive_state="$1"
adaptive_score="$2"
adaptive_reason="$3"
pause_hint="$4"
pause_score="$5"
active_floor="$6"

for n in "$now" "$seen" "$seq" "$audio" "$screen" "$pps" "$adaptive_score" "$pause_score" "$active_floor"; do
    case "$n" in ''|*[!0-9]*) echo "unknown invalid_numeric 0"; exit 0 ;; esac
done
case "$audio:$screen" in 0:0|0:1|1:0|1:1) : ;; *) echo "unknown invalid_bits 0"; exit 0 ;; esac
case "$shadow" in playing|idle|paused|app_home|system_home|sleep|unknown) : ;; *) shadow=unknown ;; esac
case "$adaptive_state" in unready|warming|idle|active|ambiguous|unknown) : ;; *) adaptive_state=unknown ;; esac
case "$adaptive_reason" in
    none|no_model|need_sessions|overlap_model|need_window|clear_current|active_votes|active_median|stable_low|overlap|unknown) : ;;
    *) adaptive_reason=unknown ;;
esac
case "$pause_hint" in none|idle_overlap|bursty_pause|high_ratio_pause|unknown) : ;; *) pause_hint=unknown ;; esac

mkdir -p "$RAM"
locked=0
if mkdir "$LOCK" 2>/dev/null; then
    locked=1
else
    sleep 1
    if mkdir "$LOCK" 2>/dev/null; then locked=1; fi
fi
[ "$locked" -eq 1 ] || { echo "unknown fusion_busy 0"; exit 0; }
cleanup() { rmdir "$LOCK" 2>/dev/null || :; }
trap cleanup EXIT HUP INT TERM

# schema v2:
# schema|last_sig|last_seq|pause_streak|pause_miss|latched|
# learned_media_pkg|learned_media_activity|home_streak|last_pkg|last_activity
schema=0
last_sig=''
last_seq=0
pause_streak=0
pause_miss=0
latched=none
media_pkg=''
media_activity=''
home_streak=0
last_pkg=''
last_activity=''
extra=''
if [ -r "$STATE" ]; then
    oldIFS="$IFS"
    IFS='|'
    read -r schema last_sig last_seq pause_streak pause_miss latched \
        media_pkg media_activity home_streak last_pkg last_activity extra < "$STATE" || :
    IFS="$oldIFS"
    if [ "$schema" != 2 ]; then
        last_sig=''; last_seq=0; pause_streak=0; pause_miss=0; latched=none
        media_pkg=''; media_activity=''; home_streak=0
        last_pkg=''; last_activity=''
    fi
    case "$last_seq" in ''|*[!0-9]*) last_seq=0 ;; esac
    case "$pause_streak" in ''|*[!0-9]*) pause_streak=0 ;; esac
    case "$pause_miss" in ''|*[!0-9]*) pause_miss=0 ;; esac
    case "$home_streak" in ''|*[!0-9]*) home_streak=0 ;; esac
    case "$latched" in none|paused) : ;; *) latched=none ;; esac
fi

sig="$seq:$seen"
fresh=1
[ "$sig" = "$last_sig" ] && fresh=0
restart=0
if [ "$fresh" -eq 1 ] && [ "$last_seq" -gt 0 ] && [ "$seq" -lt "$last_seq" ]; then
    restart=1
    pause_streak=0
    pause_miss=0
    home_streak=0
    latched=none
fi

context_changed=0
if [ "$pkg" != "$last_pkg" ] || [ "$activity" != "$last_activity" ]; then
    context_changed=1
    pause_streak=0
    pause_miss=0
    home_streak=0
    latched=none
fi

is_launcher=0
case "$pkg" in
    com.mitv.tvhome|com.mitv.home|com.android.tvlauncher|com.google.android.tvlauncher|\
    com.google.android.apps.tv.launcherx|com.android.launcher|com.android.launcher3|com.miui.tvhome)
        is_launcher=1 ;;
esac

strong_play=0
if [ "$shadow" = playing ]; then
    strong_play=1
elif [ "$adaptive_state" = active ] &&
     { [ "$adaptive_reason" = clear_current ] ||
       { [ "$active_floor" -gt 0 ] && [ "$pps" -ge "$active_floor" ]; }; }; then
    strong_play=1
fi

pause_evidence=0
if [ "$pause_hint" = high_ratio_pause ] && [ "$pause_score" -ge 90 ]; then
    pause_evidence=1
elif [ "$pause_hint" = bursty_pause ] && [ "$pause_score" -ge 75 ]; then
    pause_evidence=1
fi
[ "$strong_play" -eq 0 ] || pause_evidence=0

low_nonplaying=0
if [ "$audio" -eq 0 ] &&
   { [ "$shadow" = idle ] ||
     { [ "$adaptive_state" = idle ] && [ "$adaptive_reason" = stable_low ]; }; }; then
    low_nonplaying=1
fi

known_media_context=0
known_media_package=0
if [ -n "$media_pkg" ] && [ "$pkg" = "$media_pkg" ]; then
    known_media_package=1
    if [ -n "$media_activity" ] && [ "$activity" = "$media_activity" ]; then
        known_media_context=1
    fi
fi

combined=unknown
candidate=unknown

if [ "$screen" -eq 0 ]; then
    combined=unknown
    candidate=sleep_candidate
    pause_streak=0
    pause_miss=0
    home_streak=0
    latched=none

elif [ "$is_launcher" -eq 1 ]; then
    combined=system_home
    candidate=system_home_confirmed
    pause_streak=0
    pause_miss=0
    home_streak=0
    latched=none

elif [ "$pkg" = unknown ] || [ "$activity" = unknown ] ||
     [ -z "$pkg" ] || [ -z "$activity" ]; then
    combined=unknown
    candidate=foreground_context_unknown
    pause_streak=0
    pause_miss=0
    home_streak=0
    latched=none

elif [ "$strong_play" -eq 1 ]; then
    # Generic self-learning rule: current package/activity becomes a learned
    # media context only after N1 itself has strong playback evidence.
    media_pkg="$pkg"
    media_activity="$activity"
    known_media_package=1
    known_media_context=1
    combined=playing
    candidate=playing_confirmed_context_learned
    pause_streak=0
    pause_miss=0
    home_streak=0
    latched=none

elif [ "$known_media_context" -eq 1 ]; then
    home_streak=0
    if [ "$pause_evidence" -eq 1 ]; then
        if [ "$fresh" -eq 1 ]; then
            pause_streak=$((pause_streak + 1))
            pause_miss=0
        fi
        if [ "$latched" = paused ] || [ "$pause_streak" -ge 3 ]; then
            latched=paused
            combined=paused
            candidate=paused_confirmed_learned_context
        else
            combined=unknown
            candidate=pause_candidate_learned_context
        fi
    elif [ "$latched" = paused ]; then
        if [ "$fresh" -eq 1 ]; then pause_miss=$((pause_miss + 1)); fi
        if [ "$pause_miss" -le 1 ]; then
            combined=paused
            candidate=paused_temporal_hold
        else
            latched=none
            pause_streak=0
            pause_miss=0
            combined=unknown
            candidate=learned_media_context_unresolved
        fi
    else
        if [ "$fresh" -eq 1 ]; then
            pause_streak=0
            pause_miss=0
        fi
        combined=unknown
        if [ "$pause_hint" = idle_overlap ]; then
            # P0 invariant: stable low traffic inside a learned playback
            # context is NOT enough to grant paused/free time.
            candidate=learned_media_idle_overlap_unresolved
        elif [ "$audio" -eq 1 ]; then
            candidate=learned_media_context_audio_hint_on
        else
            candidate=learned_media_context_audio_hint_off
        fi
    fi

elif [ "$known_media_package" -eq 1 ]; then
    # Same app package, but a different Activity from the context that was
    # actually proven to play. This is the generic app-side non-playing path.
    pause_streak=0
    pause_miss=0
    latched=none
    if [ "$low_nonplaying" -eq 1 ]; then
        if [ "$fresh" -eq 1 ]; then home_streak=$((home_streak + 1)); fi
        if [ "$home_streak" -ge 3 ]; then
            combined=app_home
            candidate=app_nonplaying_confirmed
        else
            combined=unknown
            candidate=app_nonplaying_warming
        fi
    else
        if [ "$fresh" -eq 1 ]; then home_streak=0; fi
        combined=unknown
        if [ "$pause_evidence" -eq 1 ]; then
            candidate=unlearned_context_pause_hint_ignored
        else
            candidate=known_media_app_other_context
        fi
    fi

else
    # Before this package has ever produced strong playback evidence, do not
    # guess that it is a video app merely from its name or Activity spelling.
    pause_streak=0
    pause_miss=0
    home_streak=0
    latched=none
    combined=unknown
    if [ "$pause_evidence" -eq 1 ]; then
        candidate=unlearned_package_pause_hint_ignored
    else
        candidate=unlearned_foreground_context
    fi
fi

if [ "$restart" -eq 1 ]; then
    # First report after Agent recreation is context recovery only. Keep the
    # N1-learned media context in RAM, but do not count this report toward
    # pause/home hysteresis.
    pause_streak=0
    pause_miss=0
    home_streak=0
    latched=none
    case "$combined" in
        system_home) : ;;
        playing) candidate=playing_confirmed_context_recovered ;;
        *) combined=unknown; candidate=agent_process_restart_context_reset ;;
    esac
fi

if [ "$fresh" -eq 1 ]; then
    tmp="$STATE.$$"
    printf '2|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
        "$sig" "$seq" "$pause_streak" "$pause_miss" "$latched" \
        "$media_pkg" "$media_activity" "$home_streak" "$pkg" "$activity" > "$tmp"
    chmod 600 "$tmp"
    mv -f "$tmp" "$STATE"
fi

printf '%s %s %s\n' "$combined" "$candidate" "$pause_streak"
