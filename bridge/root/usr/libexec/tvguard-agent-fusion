#!/bin/sh
# TVGuard v0.3.0 generic Agent/N1 temporal + learned UI fusion.
# No video-app package names or per-app decision branches are allowed here.
# RAM-only observer: never edits quota, billing state, firewall or persistent data.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

RAM=/var/run/tvguard-agent-bridge
DATA=/usr/libexec/tvguard-data
STATE="$RAM/fusion.state"
LOCK="$RAM/fusion.lock"

argc="$#"
case "$argc" in
    15|18) : ;;
    *) echo "unknown invalid_arguments 0"; exit 0 ;;
esac

now="$1"
seen="$2"
seq="$3"
pkg="$4"
activity="$5"
audio="$6"
screen="$7"
pps="$8"
shadow="$9"
shift 9
adaptive_state="$1"
adaptive_score="$2"
adaptive_reason="$3"
pause_hint="$4"
pause_score="$5"
active_floor="$6"
ui_package=none
ui_age_ms=0
ui_fingerprint=none
if [ "$argc" -eq 18 ]; then
    ui_package="$7"
    ui_age_ms="$8"
    ui_fingerprint="$9"
fi

for n in "$now" "$seen" "$seq" "$audio" "$screen" "$pps" "$adaptive_score" "$pause_score" "$active_floor" "$ui_age_ms"; do
    case "$n" in ''|*[!0-9]*) echo "unknown invalid_numeric 0"; exit 0 ;; esac
done
case "$audio:$screen" in 0:0|0:1|1:0|1:1) : ;; *) echo "unknown invalid_bits 0"; exit 0 ;; esac
case "$shadow" in playing|idle|paused|app_home|system_home|sleep|unknown) : ;; *) shadow=unknown ;; esac
case "$adaptive_state" in unready|warming|idle|active|ambiguous|unknown) : ;; *) adaptive_state=unknown ;; esac
case "$adaptive_reason" in
    none|no_model|need_sessions|overlap_model|need_window|clear_current|active_votes|active_median|stable_low|overlap|unknown) : ;;
    *) adaptive_reason=unknown ;;
esac
case "$pause_hint" in none|idle_overlap|bursty_pause|high_ratio_pause|unknown) : ;; *) pause_hint=unknown ;; esac
case "$ui_package" in ''|*[!A-Za-z0-9._]*) ui_package=none ;; esac
case "$ui_fingerprint" in
    none) : ;;
    *[!0-9a-f]*) ui_fingerprint=none ;;
    *) [ "${#ui_fingerprint}" -eq 32 ] || ui_fingerprint=none ;;
esac

ui_fresh=0
ui_total_age_ms=0
if [ "$ui_package" = "$pkg" ] && [ "$ui_fingerprint" != none ] &&
   [ "$now" -ge "$seen" ]; then
    ui_total_age_ms=$((ui_age_ms + (now - seen) * 1000))
    if [ "$ui_total_age_ms" -le 20000 ]; then ui_fresh=1; fi
fi

mkdir -p "$RAM"
locked=0
if mkdir "$LOCK" 2>/dev/null; then
    locked=1
else
    sleep 1
    if mkdir "$LOCK" 2>/dev/null; then locked=1; fi
fi
[ "$locked" -eq 1 ] || { echo "unknown fusion_busy 0"; exit 0; }
cleanup() { rmdir "$LOCK" 2>/dev/null || :; }
trap cleanup EXIT HUP INT TERM

# schema v4:
# schema|last_sig|last_seq|pause_streak|pause_miss|latched|
# learned_media_pkg|learned_media_activity|home_streak|last_pkg|last_activity|
# last_strong_seen|burst_gap_max|burst_hits|
# switch_activity|switch_strong_hits|switch_last_strong_seen
#
# burst_* is generic temporal evidence. It learns the cadence of repeated
# strong-play confirmations in the SAME foreground context. Low-bitrate
# streaming commonly alternates long low-PPS valleys with periodic download
# bursts; those valleys must not become "paused" merely because an old pause
# prototype also looks bursty.
schema=0
last_sig=''
last_seq=0
pause_streak=0
pause_miss=0
latched=none
media_pkg=''
media_activity=''
home_streak=0
last_pkg=''
last_activity=''
last_strong_seen=0
burst_gap_max=0
burst_hits=0
switch_activity=''
switch_strong_hits=0
switch_last_strong_seen=0
extra=''
if [ -r "$STATE" ]; then
    oldIFS="$IFS"
    IFS='|'
    read -r schema last_sig last_seq pause_streak pause_miss latched \
        media_pkg media_activity home_streak last_pkg last_activity \
        last_strong_seen burst_gap_max burst_hits \
        switch_activity switch_strong_hits switch_last_strong_seen extra < "$STATE" || :
    IFS="$oldIFS"
    if [ "$schema" != 4 ]; then
        last_sig=''; last_seq=0; pause_streak=0; pause_miss=0; latched=none
        media_pkg=''; media_activity=''; home_streak=0
        last_pkg=''; last_activity=''
        last_strong_seen=0; burst_gap_max=0; burst_hits=0
        switch_activity=''; switch_strong_hits=0; switch_last_strong_seen=0
    fi
    case "$last_seq" in ''|*[!0-9]*) last_seq=0 ;; esac
    case "$pause_streak" in ''|*[!0-9]*) pause_streak=0 ;; esac
    case "$pause_miss" in ''|*[!0-9]*) pause_miss=0 ;; esac
    case "$home_streak" in ''|*[!0-9]*) home_streak=0 ;; esac
    case "$last_strong_seen" in ''|*[!0-9]*) last_strong_seen=0 ;; esac
    case "$burst_gap_max" in ''|*[!0-9]*) burst_gap_max=0 ;; esac
    case "$burst_hits" in ''|*[!0-9]*) burst_hits=0 ;; esac
    case "$switch_strong_hits" in ''|*[!0-9]*) switch_strong_hits=0 ;; esac
    case "$switch_last_strong_seen" in ''|*[!0-9]*) switch_last_strong_seen=0 ;; esac
    case "$latched" in none|paused) : ;; *) latched=none ;; esac
fi

sig="$seq:$seen"
fresh=1
[ "$sig" = "$last_sig" ] && fresh=0
restart=0
if [ "$fresh" -eq 1 ] && [ "$last_seq" -gt 0 ] && [ "$seq" -lt "$last_seq" ]; then
    restart=1
    pause_streak=0
    pause_miss=0
    home_streak=0
    latched=none
    switch_activity=''
    switch_strong_hits=0
    switch_last_strong_seen=0
fi

pkg_known=1
activity_known=1
case "$pkg" in ''|unknown) pkg_known=0 ;; esac
case "$activity" in ''|unknown) activity_known=0 ;; esac
full_context=0
if [ "$pkg_known" -eq 1 ] && [ "$activity_known" -eq 1 ]; then full_context=1; fi

# Manual-learning profiles are keyed by exact package+Activity and only use
# completed high-quality network + Agent joint sessions. Older 18-column rows
# are ignored because they cannot prove full-context stability.
#
# Type A: playing + paused share one exact context, with no app_home conflict.
# Type D: playing + paused + app_home ALL share one exact context. In that case
# audio may teach only playing vs generic nonplaying; billing must not pretend
# that audio=0 distinguishes paused from app_home.
learned_audio_profile=0
learned_nonplaying_profile=0
learned_play_audio=0
learned_pause_audio=0
learned_home_audio=0
if [ "$full_context" -eq 1 ] && [ -x "$DATA" ]; then
    data_root="$("$DATA" root 2>/dev/null || :)"
    model="$data_root/learning-sessions.csv"
    if [ -n "$data_root" ] && [ -s "$model" ]; then
        profile="$(awk -F, -v pkg="$pkg" -v activity="$activity" '
        NF>=29 && $6=="completed" && $18=="high" && $19=="high" &&
        $23==pkg && $25==activity && $24+0>=75 && $26+0>=75 && $28+0>=90 {
            if ($3=="playing") {
                pn++
                pa += $27+0
            } else if ($3=="paused") {
                qn++
                qa += $27+0
            } else if ($3=="app_home") {
                hn++
                ha += $27+0
            }
        }
        END {
            p=(pn>0 ? int(pa/pn) : 0)
            q=(qn>0 ? int(qa/qn) : 0)
            h=(hn>0 ? int(ha/hn) : 0)
            typea=(pn>=1 && qn>=1 && hn==0 &&
                   p>=70 && q<=30 && p-q>=50)
            typed=(pn>=1 && qn>=1 && hn>=1 &&
                   p>=70 && q<=30 && h<=30 &&
                   p-q>=50 && p-h>=50)
            printf "%d %d %d %d %d\n", typea,typed,p,q,h
        }' "$model" 2>/dev/null || echo '0 0 0 0 0')"
        set -- $profile
        if [ "$#" -eq 5 ]; then
            case "$1:$2:$3:$4:$5" in
                *[!0-9:]*|'') : ;;
                *)
                    learned_audio_profile="$1"
                    learned_nonplaying_profile="$2"
                    learned_play_audio="$3"
                    learned_pause_audio="$4"
                    learned_home_audio="$5"
                    ;;
            esac
        fi
    fi
fi
case "$learned_audio_profile" in 0|1) : ;; *) learned_audio_profile=0 ;; esac
case "$learned_nonplaying_profile" in 0|1) : ;; *) learned_nonplaying_profile=0 ;; esac

# UI profile authority is learned only from completed high-quality manual
# sessions that have stable exact package+Activity and stable TVG4 structure
# fingerprints. The runtime fingerprint must be unique to one learned label;
# any conflict or unknown structure fails closed.
learned_ui_profile=0
learned_ui_match=unmatched
if [ "$full_context" -eq 1 ] && [ -x "$DATA" ]; then
    data_root="$("$DATA" root 2>/dev/null || :)"
    model="$data_root/learning-sessions.csv"
    if [ -n "$data_root" ] && [ -s "$model" ]; then
        ui_profile="$(awk -F, -v pkg="$pkg" -v activity="$activity" -v fp="$ui_fingerprint" '
        NF>=40 && $6=="completed" && $18=="high" && $19=="high" &&
        $23==pkg && $25==activity && $24+0>=75 && $26+0>=75 &&
        $31+0>=75 && $32==pkg && $33+0>=90 &&
        length($34)==32 && $34 !~ /[^0-9a-f]/ && $35+0>=75 && $40=="high" {
            if ($3=="playing") { pn++; play[$34]++ }
            else if ($3=="paused") { qn++; pause[$34]++ }
            else if ($3=="app_home") { hn++; home[$34]++ }
        }
        END {
            profile=(pn>=1 && qn>=1)
            pm=(fp!="" && fp!="none" && play[fp]>0)
            qm=(fp!="" && fp!="none" && pause[fp]>0)
            hm=(fp!="" && fp!="none" && home[fp]>0)
            kind="unmatched"
            if (pm && !qm && !hm) kind="playing"
            else if (qm && !pm && !hm) kind="paused"
            else if (hm && !pm && !qm) kind="app_home"
            else if (pm || qm || hm) kind="conflict"
            printf "%d %s\n", profile, kind
        }' "$model" 2>/dev/null || echo '0 unmatched')"
        set -- $ui_profile
        if [ "$#" -eq 2 ]; then
            case "$1" in 0|1) learned_ui_profile="$1" ;; *) learned_ui_profile=0 ;; esac
            case "$2" in playing|paused|app_home|conflict|unmatched) learned_ui_match="$2" ;; *) learned_ui_match=unmatched ;; esac
        fi
    fi
fi

context_changed=0
if [ "$full_context" -eq 1 ] &&
   { [ "$pkg" != "$last_pkg" ] || [ "$activity" != "$last_activity" ]; }; then
    context_changed=1
    pause_streak=0
    pause_miss=0
    home_streak=0
    latched=none
    # Burst cadence belongs to one exact foreground context. Never transfer it
    # to another Activity/package.
    last_strong_seen=0
    burst_gap_max=0
    burst_hits=0
    if [ -n "$media_pkg" ] && [ "$pkg" = "$media_pkg" ] &&
       [ -n "$media_activity" ] && [ "$activity" != "$media_activity" ]; then
        switch_activity="$activity"
    else
        switch_activity=''
    fi
    switch_strong_hits=0
    switch_last_strong_seen=0
elif [ "$full_context" -eq 0 ]; then
    # Incomplete foreground evidence may never preserve a free-time latch.
    # Keep learned exact context in RAM for later recovery, but clear votes.
    pause_streak=0
    pause_miss=0
    home_streak=0
    latched=none
    switch_activity=''
    switch_strong_hits=0
    switch_last_strong_seen=0
fi

is_launcher=0
case "$pkg" in
    com.mitv.tvhome|com.mitv.home|com.android.tvlauncher|com.google.android.tvlauncher|\
    com.google.android.apps.tv.launcherx|com.android.launcher|com.android.launcher3|com.miui.tvhome)
        is_launcher=1 ;;
esac

strong_play=0
if [ "$shadow" = playing ]; then
    strong_play=1
elif [ "$adaptive_state" = active ] &&
     { [ "$adaptive_reason" = clear_current ] ||
       { [ "$active_floor" -gt 0 ] && [ "$pps" -ge "$active_floor" ]; }; }; then
    strong_play=1
fi

pause_evidence=0
if [ "$pause_hint" = high_ratio_pause ] && [ "$pause_score" -ge 90 ]; then
    pause_evidence=1
elif [ "$pause_hint" = bursty_pause ] && [ "$pause_score" -ge 75 ]; then
    pause_evidence=1
fi
[ "$strong_play" -eq 0 ] || pause_evidence=0

low_nonplaying=0
if [ "$audio" -eq 0 ] &&
   { [ "$shadow" = idle ] ||
     { [ "$adaptive_state" = idle ] && [ "$adaptive_reason" = stable_low ]; }; }; then
    low_nonplaying=1
fi

known_media_context=0
known_media_package=0
if [ -n "$media_pkg" ] && [ "$pkg" = "$media_pkg" ]; then
    known_media_package=1
    if [ -n "$media_activity" ] && [ "$activity" = "$media_activity" ]; then
        known_media_context=1
    fi
fi

# Generic low-bitrate burst guard.
#
# Bootstrap: after one unequivocal play sample, suppress pause votes for 45 s.
# Once repeated strong-play samples establish a cadence (gap 10..90 s), learn
# the largest observed gap and guard for gap+20 s, bounded to 45..90 s.
# This intentionally biases toward P0: unknown/charged is safer than granting
# paused/free time to real low-bitrate playback. It is shadow-only today.
burst_guard=0
burst_guard_window=45
if [ "$burst_hits" -ge 2 ] && [ "$burst_gap_max" -gt 0 ]; then
    burst_guard_window=$((burst_gap_max + 20))
    [ "$burst_guard_window" -ge 45 ] || burst_guard_window=45
    [ "$burst_guard_window" -le 90 ] || burst_guard_window=90
fi
if [ "$known_media_context" -eq 1 ] && [ "$last_strong_seen" -gt 0 ] &&
   [ "$now" -ge "$last_strong_seen" ] &&
   [ $((now - last_strong_seen)) -le "$burst_guard_window" ]; then
    burst_guard=1
fi

combined=unknown
candidate=unknown

if [ "$screen" -eq 0 ]; then
    combined=unknown
    candidate=sleep_candidate
    pause_streak=0
    pause_miss=0
    home_streak=0
    latched=none

elif [ "$is_launcher" -eq 1 ] && [ "$full_context" -eq 1 ]; then
    combined=system_home
    candidate=system_home_confirmed
    pause_streak=0
    pause_miss=0
    home_streak=0
    latched=none

elif [ "$learned_nonplaying_profile" -eq 1 ]; then
    # Type-D shared-context profile: human-labelled playing, paused and app_home
    # sessions all use this exact package+Activity. Audio may therefore prove
    # playing vs generic nonplaying, but it must NOT pretend to distinguish
    # paused from app_home. Network state is deliberately not allowed to veto
    # the learned nonplaying decision because paused may still download heavily.
    media_pkg="$pkg"
    media_activity="$activity"
    known_media_package=1
    known_media_context=1
    home_streak=0
    switch_activity=''
    switch_strong_hits=0
    switch_last_strong_seen=0

    if [ "$audio" -eq 1 ]; then
        combined=playing
        candidate=playing_confirmed_learned_nonplaying_profile
        pause_streak=0
        pause_miss=0
        latched=none
        last_strong_seen="$now"
    else
        if [ "$fresh" -eq 1 ]; then
            pause_streak=$((pause_streak + 1))
            pause_miss=0
        fi
        if [ "$latched" = paused ] || [ "$pause_streak" -ge 2 ]; then
            # Reuse the existing latch storage but expose an honest public
            # state: we know the exact context is non-playing, not whether the
            # user is paused or browsing the app home page.
            latched=paused
            combined=nonplaying
            candidate=nonplaying_confirmed_learned_audio_context
        else
            combined=unknown
            candidate=nonplaying_audio_profile_warming
        fi
    fi

elif [ "$learned_audio_profile" -eq 1 ]; then
    # Human-labelled paired playing/paused sessions have taught this exact
    # context that audio-active separates playback from pause. This branch is
    # intentionally above network strong_play: a paused player may keep
    # downloading at hundreds of PPS, while low-bitrate playback may dip far
    # below the learned network floor.
    media_pkg="$pkg"
    media_activity="$activity"
    known_media_package=1
    known_media_context=1
    home_streak=0
    switch_activity=''
    switch_strong_hits=0
    switch_last_strong_seen=0

    if [ "$audio" -eq 1 ]; then
        combined=playing
        candidate=playing_confirmed_learned_audio_profile
        pause_streak=0
        pause_miss=0
        latched=none
        last_strong_seen="$now"
    else
        if [ "$fresh" -eq 1 ]; then
            pause_streak=$((pause_streak + 1))
            pause_miss=0
        fi
        # Paired manual playing/paused learning plus exact full-context
        # makes this branch much narrower than the legacy network-pause path.
        # Two NEW reports preserve one anti-glitch interval while reducing
        # pause overbilling from roughly 30s to roughly 20s. The legacy
        # pause-evidence path below intentionally remains at three reports.
        if [ "$latched" = paused ] || [ "$pause_streak" -ge 2 ]; then
            latched=paused
            combined=paused
            candidate=paused_confirmed_learned_audio_context
        else
            combined=unknown
            candidate=paused_audio_profile_warming
        fi
    fi

elif [ "$learned_ui_profile" -eq 1 ]; then
    # Generic learned UI profile: this is the narrow path for apps where
    # playing and paused share package+Activity and audio cannot separate them.
    # UI is authoritative only after manual high-confidence learning and only
    # while the structure snapshot is fresh and belongs to this foreground app.
    media_pkg="$pkg"
    media_activity="$activity"
    known_media_package=1
    known_media_context=1
    home_streak=0
    switch_activity=''
    switch_strong_hits=0
    switch_last_strong_seen=0

    if [ "$ui_fresh" -ne 1 ]; then
        combined=unknown
        candidate=learned_ui_profile_unavailable
        pause_streak=0
        pause_miss=0
        latched=none
    elif [ "$learned_ui_match" = playing ]; then
        combined=playing
        candidate=playing_confirmed_learned_ui_context
        pause_streak=0
        pause_miss=0
        latched=none
        last_strong_seen="$now"
    elif [ "$learned_ui_match" = paused ]; then
        if [ "$fresh" -eq 1 ]; then
            pause_streak=$((pause_streak + 1))
            pause_miss=0
        fi
        if [ "$latched" = paused ] || [ "$pause_streak" -ge 2 ]; then
            latched=paused
            combined=paused
            candidate=paused_confirmed_learned_ui_context
        else
            combined=unknown
            candidate=paused_ui_profile_warming
        fi
    elif [ "$learned_ui_match" = app_home ]; then
        pause_streak=0
        pause_miss=0
        latched=none
        if [ "$fresh" -eq 1 ]; then home_streak=$((home_streak + 1)); fi
        if [ "$home_streak" -ge 2 ]; then
            combined=app_home
            candidate=app_home_confirmed_learned_ui_context
        else
            combined=unknown
            candidate=app_home_ui_profile_warming
        fi
    else
        combined=unknown
        candidate=learned_ui_context_unresolved
        pause_streak=0
        pause_miss=0
        home_streak=0
        latched=none
    fi

elif [ "$pkg_known" -eq 0 ]; then
    if [ "$strong_play" -eq 1 ] && [ "$audio" -eq 1 ]; then
        combined=playing
        candidate=playing_network_audio_fallback
    else
        combined=unknown
        candidate=foreground_package_unknown
    fi

elif [ "$activity_known" -eq 0 ]; then
    if [ "$strong_play" -eq 1 ] && [ "$audio" -eq 1 ]; then
        combined=playing
        candidate=playing_package_only_fallback
    elif [ "$is_launcher" -eq 1 ]; then
        combined=unknown
        candidate=launcher_context_incomplete
    else
        combined=unknown
        candidate=package_only_context_unresolved
    fi

elif [ "$strong_play" -eq 1 ]; then
    # Once a package already has a learned playback Activity, one strong
    # loading burst in a DIFFERENT Activity must not overwrite that context.
    # App home/detail/search pages commonly burst while loading. Require three
    # fresh strong-play confirmations in the same new Activity before promoting
    # it to the package's new playback context.
    if [ "$known_media_package" -eq 1 ] && [ "$known_media_context" -eq 0 ]; then
        if [ "$switch_activity" != "$activity" ]; then
            switch_activity="$activity"
            switch_strong_hits=0
            switch_last_strong_seen=0
        fi
        if [ "$fresh" -eq 1 ]; then
            if [ "$switch_last_strong_seen" -gt 0 ] &&
               [ "$now" -gt "$switch_last_strong_seen" ] &&
               [ $((now - switch_last_strong_seen)) -le 90 ]; then
                switch_strong_hits=$((switch_strong_hits + 1))
            else
                switch_strong_hits=1
            fi
            switch_last_strong_seen="$now"
        fi

        pause_streak=0
        pause_miss=0
        home_streak=0
        latched=none
        if [ "$switch_strong_hits" -ge 3 ]; then
            media_activity="$activity"
            known_media_context=1
            last_strong_seen="$now"
            burst_gap_max=0
            burst_hits=1
            switch_activity=''
            switch_strong_hits=0
            switch_last_strong_seen=0
            combined=playing
            candidate=playing_confirmed_context_switched
        else
            combined=unknown
            candidate=media_context_switch_play_warming
        fi
    else
        # First-ever media context, or another strong sample in the already
        # learned playback context.
        if [ "$known_media_context" -eq 1 ] && [ "$last_strong_seen" -gt 0 ] &&
           [ "$now" -gt "$last_strong_seen" ]; then
            gap=$((now - last_strong_seen))
            if [ "$gap" -ge 10 ] && [ "$gap" -le 90 ]; then
                burst_hits=$((burst_hits + 1))
                [ "$gap" -le "$burst_gap_max" ] || burst_gap_max="$gap"
            else
                burst_hits=1
                burst_gap_max=0
            fi
        else
            burst_hits=1
            burst_gap_max=0
        fi
        last_strong_seen="$now"

        media_pkg="$pkg"
        media_activity="$activity"
        known_media_package=1
        known_media_context=1
        combined=playing
        candidate=playing_confirmed_context_learned
        pause_streak=0
        pause_miss=0
        home_streak=0
        latched=none
        switch_activity=''
        switch_strong_hits=0
        switch_last_strong_seen=0
    fi

elif [ "$known_media_context" -eq 1 ]; then
    home_streak=0

    if [ "$burst_guard" -eq 1 ]; then
        # Critical P0 rule: pause prototypes are allowed to overlap a periodic
        # low-bitrate download valley. Recent repeated strong-play evidence wins
        # until the learned burst cadence has actually been missed.
        combined=unknown
        candidate=recent_play_burst_guard
        pause_streak=0
        pause_miss=0
        latched=none

    elif [ "$pause_evidence" -eq 1 ]; then
        if [ "$fresh" -eq 1 ]; then
            pause_streak=$((pause_streak + 1))
            pause_miss=0
        fi
        if [ "$latched" = paused ] || [ "$pause_streak" -ge 3 ]; then
            latched=paused
            combined=paused
            candidate=paused_confirmed_learned_context
        else
            combined=unknown
            candidate=pause_candidate_learned_context
        fi

    elif [ "$latched" = paused ]; then
        if [ "$fresh" -eq 1 ]; then pause_miss=$((pause_miss + 1)); fi
        if [ "$pause_miss" -le 1 ]; then
            combined=paused
            candidate=paused_temporal_hold
        else
            latched=none
            pause_streak=0
            pause_miss=0
            combined=unknown
            candidate=learned_media_context_unresolved
        fi

    else
        if [ "$fresh" -eq 1 ]; then
            pause_streak=0
            pause_miss=0
        fi
        combined=unknown
        if [ "$pause_hint" = idle_overlap ]; then
            candidate=learned_media_idle_overlap_unresolved
        elif [ "$audio" -eq 1 ]; then
            candidate=learned_media_context_audio_hint_on
        else
            candidate=learned_media_context_audio_hint_off
        fi
    fi

elif [ "$known_media_package" -eq 1 ]; then
    pause_streak=0
    pause_miss=0
    latched=none
    if [ "$low_nonplaying" -eq 1 ]; then
        switch_activity="$activity"
        switch_strong_hits=0
        switch_last_strong_seen=0
        if [ "$fresh" -eq 1 ]; then home_streak=$((home_streak + 1)); fi
        if [ "$home_streak" -ge 3 ]; then
            combined=app_home
            candidate=app_nonplaying_confirmed
        else
            combined=unknown
            candidate=app_nonplaying_warming
        fi
    else
        if [ "$fresh" -eq 1 ]; then home_streak=0; fi
        combined=unknown
        if [ "$pause_evidence" -eq 1 ]; then
            candidate=unlearned_context_pause_hint_ignored
        else
            candidate=known_media_app_other_context
        fi
    fi

else
    pause_streak=0
    pause_miss=0
    home_streak=0
    latched=none
    combined=unknown
    if [ "$pause_evidence" -eq 1 ]; then
        candidate=unlearned_package_pause_hint_ignored
    else
        candidate=unlearned_foreground_context
    fi
fi

if [ "$restart" -eq 1 ]; then
    pause_streak=0
    pause_miss=0
    home_streak=0
    latched=none
    case "$combined" in
        system_home) : ;;
        playing)
            case "$candidate" in
                playing_network_audio_fallback|playing_package_only_fallback) : ;;
                *) candidate=playing_confirmed_context_recovered ;;
            esac
            ;;
        *) combined=unknown; candidate=agent_process_restart_context_reset ;;
    esac
fi

if [ "$fresh" -eq 1 ]; then
    if [ "$full_context" -eq 1 ]; then
        last_pkg="$pkg"
        last_activity="$activity"
    fi
    tmp="$STATE.$"
    printf '4|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
        "$sig" "$seq" "$pause_streak" "$pause_miss" "$latched" \
        "$media_pkg" "$media_activity" "$home_streak" "$last_pkg" "$last_activity" \
        "$last_strong_seen" "$burst_gap_max" "$burst_hits" \
        "$switch_activity" "$switch_strong_hits" "$switch_last_strong_seen" > "$tmp"
    chmod 600 "$tmp"
    mv -f "$tmp" "$STATE"
fi

printf '%s %s %s\n' "$combined" "$candidate" "$pause_streak"
