#!/bin/sh
# Bounded RAM-only v0.2.8 generic fusion ring. No quota, firewall or persistence writes.
# Distinguishes new TV reports from repeated N1 reads of the same report.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
RAM=/var/run/tvguard-agent-bridge
DATA="$RAM/soak-v3.csv"
last_signature=''
last_seq=''

if [ -s "$DATA" ]; then
    last_line="$(tail -n 1 "$DATA" 2>/dev/null || :)"
    last_seq="$(printf '%s\n' "$last_line" | awk -F, '{print $20}')"
    last_recv="$(printf '%s\n' "$last_line" | awk -F, '{print $21}')"
    case "$last_seq:$last_recv" in
        *[!0-9:]*|:|*:) last_seq='' ;;
        *) last_signature="$last_seq:$last_recv" ;;
    esac
fi

trap 'exit 0' TERM INT

while :; do
    if [ -s "$RAM/latest" ]; then
        status="$(/usr/libexec/tvguard-agent-bridge-report status 2>/dev/null || :)"
        if [ -n "$status" ]; then
            signature="$(printf '%s\n' "$status" | awk -F= '
                $1=="report_seq" || $1=="last_report_seq" {s=$2}
                $1=="received_epoch" || $1=="last_received_epoch" {r=$2}
                END {if (s!="" && r!="") printf "%s:%s",s,r}
            ')"
            fresh=1
            if [ -z "$signature" ] || [ "$signature" = "$last_signature" ]; then
                fresh=0
            fi
            current_seq="$(printf '%s\n' "$status" | awk -F= '
                $1=="report_seq" || $1=="last_report_seq" {print $2; exit}
            ')"
            restart=0
            case "$current_seq:$last_seq" in
                *[!0-9:]*|:*|*:) : ;;
                *) if [ "$fresh" -eq 1 ] && [ "$current_seq" -lt "$last_seq" ]; then restart=1; fi ;;
            esac

            fields="$(printf '%s\n' "$status" | awk -F= -v fresh="$fresh" -v restart="$restart" '
                $1=="agent" {a=$2}
                $1=="age_seconds" {age=$2}
                $1=="package" {p=$2}
                $1=="activity" {c=$2}
                $1=="audio_active" {au=$2}
                $1=="screen_on" {sc=$2}
                $1=="network_pps" {pps=$2}
                $1=="network_shadow" {sh=$2}
                $1=="adaptive_state" {ast=$2}
                $1=="adaptive_score" {asc=$2}
                $1=="adaptive_reason" {ar=$2}
                $1=="pause_hint" {ph=$2}
                $1=="pause_score" {ps=$2}
                $1=="adaptive_p50" {p50=$2}
                $1=="adaptive_p90" {p90=$2}
                $1=="adaptive_active_floor" {af=$2}
                $1=="combined_state" {cs=$2}
                $1=="combined_candidate" {can=$2}
                $1=="fusion_pause_streak" {fs=$2}
                $1=="report_seq" || $1=="last_report_seq" {seq=$2}
                $1=="received_epoch" || $1=="last_received_epoch" {recv=$2}
                END {
                    if (a=="online") {
                        if (fresh != 1) can="repeated_report_not_new_evidence"
                        else if (restart == 1) can="agent_process_restart_suspected"
                    } else if (a=="stale") {
                        p=c=au=sc=pps=sh=ast=ar=ph=cs="unknown"
                        asc=ps=p50=p90=af=fs=0
                        can="agent_stale"
                        fresh=0
                    } else {
                        exit
                    }

                    v[1]=age; v[2]=p; v[3]=c; v[4]=au; v[5]=sc
                    v[6]=pps; v[7]=sh; v[8]=ast; v[9]=asc; v[10]=ar
                    v[11]=ph; v[12]=ps; v[13]=p50; v[14]=p90; v[15]=af
                    v[16]=cs; v[17]=can; v[18]=fs; v[19]=seq
                    v[20]=recv; v[21]=fresh
                    for (i=1;i<=21;i++) {
                        if (i>1) printf ","
                        printf "%s", v[i]
                    }
                }
            ')"
            if [ -n "$fields" ]; then
                printf '%s,%s\n' "$(date +%s)" "$fields" >> "$DATA"
                [ -n "$signature" ] && last_signature="$signature"
                if [ "$fresh" -eq 1 ]; then
                    case "$current_seq" in ''|*[!0-9]*) : ;; *) last_seq="$current_seq" ;; esac
                fi
                lines="$(wc -l < "$DATA")"
                if [ "$lines" -gt 180 ]; then
                    tail -n 120 "$DATA" > "$RAM/soak-v3.tmp"
                    mv -f "$RAM/soak-v3.tmp" "$DATA"
                fi
            fi
        fi
    fi
    sleep 10
done
