#!/bin/sh
# Conservative formal-billing hint for TVGuard core.
# This helper NEVER edits quota, firewall, UCI or persistent state.
#
# Contract:
#   free system_home  - only when generic fusion explicitly confirms TV launcher
#   free app_home     - only when generic fusion explicitly confirms app-side non-playing UI
#   free paused       - only for freshly confirmed learned-context pause
#   free nonplaying   - only for a three-state shared-context learned profile
#   charge <state>    - playing/unknown and any non-confirmed free-state candidate
#
# Missing/stale/invalid Agent context always fails closed to "charge unknown".
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

RAM=/var/run/tvguard-agent-bridge
LATEST="$RAM/latest"
FUSION=/usr/libexec/tvguard-agent-fusion

[ "$#" -eq 9 ] || {
    echo "charge unknown"
    exit 0
}

now="$1"
pps="$2"
shadow="$3"
adaptive_state="$4"
adaptive_score="$5"
adaptive_reason="$6"
pause_hint="$7"
pause_score="$8"
active_floor="$9"

for n in "$now" "$pps" "$adaptive_score" "$pause_score" "$active_floor"; do
    case "$n" in ''|*[!0-9]*) echo "charge unknown"; exit 0 ;; esac
done

[ -r "$LATEST" ] || {
    echo "charge unknown"
    exit 0
}
IFS='|' read -r seen pkg activity audio screen client_ms seq usage_access foreground_source foreground_status activity_trail ui_package ui_age_ms ui_nodes ui_clickable ui_focused ui_ids ui_fingerprint < "$LATEST" || :
ui_package="${ui_package:-none}"
ui_age_ms="${ui_age_ms:-0}"
ui_fingerprint="${ui_fingerprint:-none}"
for n in "${seen:-}" "${seq:-}" "${audio:-}" "${screen:-}"; do
    case "$n" in ''|*[!0-9]*) echo "charge unknown"; exit 0 ;; esac
done
case "$audio:$screen" in 0:0|0:1|1:0|1:1) : ;; *) echo "charge unknown"; exit 0 ;; esac
[ -n "${pkg:-}" ] && [ -n "${activity:-}" ] || {
    echo "charge unknown"
    exit 0
}

age=$((now - seen))
# Billing authority is stricter than transport diagnostics. A delayed Agent
# report may be useful for forensics but may never grant free time.
if [ "$age" -lt 0 ] || [ "$age" -gt 20 ]; then
    echo "charge unknown"
    exit 0
fi

[ -x "$FUSION" ] || {
    echo "charge unknown"
    exit 0
}

fusion="$("$FUSION" "$now" "$seen" "$seq" "$pkg" "$activity" "$audio" "$screen" \
    "$pps" "$shadow" "$adaptive_state" "$adaptive_score" "$adaptive_reason" \
    "$pause_hint" "$pause_score" "$active_floor" "$ui_package" "$ui_age_ms" "$ui_fingerprint" \
    2>/dev/null || echo 'unknown fusion_error 0')"
set -- $fusion
[ "$#" -eq 3 ] || {
    echo "charge unknown"
    exit 0
}

case "$1" in
    system_home)
        echo "free system_home"
        ;;
    app_home)
        case "$2" in
            app_home_confirmed_learned_ui_context|app_nonplaying_confirmed|system_home_confirmed)
                echo "free app_home"
                ;;
            *)
                # Existing generic app_home confirmation is already narrow; this
                # fallback preserves its billing contract while UI-specific
                # paths still require explicit confirmation.
                echo "free app_home"
                ;;
        esac
        ;;
    nonplaying)
        case "$2" in
            nonplaying_confirmed_learned_audio_context)
                echo "free nonplaying"
                ;;
            *)
                echo "charge nonplaying"
                ;;
        esac
        ;;
    paused)
        # Billing authority is narrower than the displayed Fusion state.
        # Only the current, freshly-confirmed paused state is free. The
        # temporal hold is deliberately still chargeable so an uncertain
        # transition back to playback cannot inherit free time.
        case "$2" in
            paused_confirmed_learned_context|paused_confirmed_learned_audio_context|paused_confirmed_learned_ui_context)
                echo "free paused"
                ;;
            *)
                echo "charge paused"
                ;;
        esac
        ;;
    playing|unknown)
        echo "charge $1"
        ;;
    *)
        echo "charge unknown"
        ;;
esac
