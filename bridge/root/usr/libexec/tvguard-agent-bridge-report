#!/bin/sh
# User-facing N1-only shadow fusion. Read-only; does NOT edit quota or gate.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
LATEST=/var/run/tvguard-agent-bridge/latest
KEY_FILE=/etc/tvguard/agent-bridge.key
case "${1:-status}" in
    doctor)
        printf 'bridge_component=installed\n'
        [ -r "$KEY_FILE" ] && printf 'pairing_key=present\n' || printf 'pairing_key=missing\n'
        tvip="$(uci -q get tvguard.main.ip 2>/dev/null || :)"
        printf 'bound_tv_ip=%s\n' "${tvip:-missing}"
        [ -x /www/cgi-bin/tvguard-agent ] &&
            printf 'cgi_script=installed\n' || printf 'cgi_script=missing\n'
        cgi_prefix="$(uci -q get uhttpd.main.cgi_prefix 2>/dev/null || :)"
        printf 'cgi_prefix=%s\n' "${cgi_prefix:-unknown}"
        case "$cgi_prefix" in
            /cgi-bin) printf 'cgi_prefix_match=yes\n' ;;
            *) printf 'cgi_prefix_match=check_uhttpd_config\n' ;;
        esac
        [ -d /var/run/tvguard-agent-bridge ] &&
            printf 'ram_path=present\n' || printf 'ram_path=not_yet_created\n'
        printf 'core_billing_modified=no\n'
        exit 0 ;;
    pairing)
        if [ -r "$KEY_FILE" ]; then cat "$KEY_FILE"; else echo 'not-paired'; fi
        exit 0 ;;
    history)
        [ -r /var/run/tvguard-agent-bridge/soak.csv ] && cat /var/run/tvguard-agent-bridge/soak.csv || echo "no samples"
        exit 0 ;;
    status) : ;;
    *) echo 'usage: tvguard-agent-bridge-report [doctor|status|history|pairing]' >&2; exit 2 ;;
esac
[ -r "$LATEST" ] || { printf 'agent=missing\nactivity=unknown\nbilling_effect=none\n'; exit 0; }
IFS='|' read -r seen pkg activity audio screen client_ms seq < "$LATEST" || :
case "${seen:-}" in ''|*[!0-9]*) echo 'agent=invalid'; exit 0 ;; esac
now="$(date +%s)"
age=$((now - seen))
if [ "$age" -lt 0 ] || [ "$age" -gt 35 ]; then
    # Forensics only: identify which report was last received, but do not
    # present its old PlayerActivity as a live/current video state.
    printf 'agent=stale\nage_seconds=%s\nlast_received_epoch=%s\nlast_report_seq=%s\nlast_package=%s\nactivity=unknown\nbilling_effect=none\n' \
        "$age" "$seen" "${seq:-unknown}" "${pkg:-unknown}"
    exit 0
fi
network_pps=unknown
shadow=unknown
if [ -x /usr/libexec/tvguard-status ] && command -v jsonfilter >/dev/null 2>&1; then
    status="$(/usr/libexec/tvguard-status status 2>/dev/null || :)"
    if [ -n "$status" ]; then
        p="$(printf '%s' "$status" | jsonfilter -e '@.pps' 2>/dev/null || :)"
        s="$(printf '%s' "$status" | jsonfilter -e '@.shadow_label' 2>/dev/null || :)"
        case "$p" in ''|*[!0-9]*) : ;; *) network_pps="$p";; esac
        case "$s" in playing|paused|app_home|system_home|unknown) shadow="$s";; esac
    fi
fi
case "$pkg:$activity:$screen:$audio" in
    *:0:*) candidate=sleep_candidate ;;
    com.mitv.tvhome:*|com.android.tvlauncher:*|com.google.android.tvlauncher:*)
        candidate=system_home ;;
    com.gitvdemo.video:*|com.ktcp.video:*|org.smarttube.stable:*|com.hunantv.license:*)
        case "$activity" in
            *Player*|*player*|*VideoActivity*|*Playback*)
                if [ "$audio" = 1 ]; then candidate=playing_candidate
                else candidate=player_state_unresolved_audio_hint_off; fi ;;
            *) candidate=app_home_candidate ;;
        esac ;;
    *) candidate=unknown ;;
esac
if [ "$age" -gt 20 ]; then
    candidate=agent_report_delayed
fi
printf 'agent=online\nage_seconds=%s\nreceived_epoch=%s\nreport_seq=%s\nclient_epoch_ms=%s\npackage=%s\nactivity=%s\naudio_active=%s\nscreen_on=%s\nnetwork_pps=%s\nnetwork_shadow=%s\ncombined_candidate=%s\nbilling_effect=none\n' \
   "$age" "$seen" "$seq" "$client_ms" "$pkg" "$activity" "$audio" "$screen" "$network_pps" "$shadow" "$candidate"
