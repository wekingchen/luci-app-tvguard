#!/bin/sh
# User-facing N1-only v0.2.7 shadow fusion. Read-only for core TVGuard.
# Temporal fusion state lives only in /var/run and NEVER edits quota or gate.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
RAM=/var/run/tvguard-agent-bridge
LATEST="$RAM/latest"
FUSION=/usr/libexec/tvguard-agent-fusion
KEY_FILE=/etc/tvguard/agent-bridge.key

case "${1:-status}" in
    doctor)
        printf 'bridge_component=installed\n'
        [ -r "$KEY_FILE" ] && printf 'pairing_key=present\n' || printf 'pairing_key=missing\n'
        tvip="$(uci -q get tvguard.main.ip 2>/dev/null || :)"
        printf 'bound_tv_ip=%s\n' "${tvip:-missing}"
        [ -x /www/cgi-bin/tvguard-agent ] &&
            printf 'cgi_script=installed\n' || printf 'cgi_script=missing\n'
        [ -x "$FUSION" ] &&
            printf 'fusion_component=installed\n' || printf 'fusion_component=missing\n'
        cgi_prefix="$(uci -q get uhttpd.main.cgi_prefix 2>/dev/null || :)"
        printf 'cgi_prefix=%s\n' "${cgi_prefix:-unknown}"
        case "$cgi_prefix" in
            /cgi-bin) printf 'cgi_prefix_match=yes\n' ;;
            *) printf 'cgi_prefix_match=check_uhttpd_config\n' ;;
        esac
        [ -d "$RAM" ] &&
            printf 'ram_path=present\n' || printf 'ram_path=not_yet_created\n'
        printf 'core_billing_modified=no\n'
        exit 0 ;;
    pairing)
        if [ -r "$KEY_FILE" ]; then cat "$KEY_FILE"; else echo 'not-paired'; fi
        exit 0 ;;
    summary)
        if [ ! -s "$RAM/soak-v3.csv" ]; then
            printf 'schema=v3\nrows=0\nfresh_reports=0\nrepeated_rows=0\nstale_rows=0\ncombined_playing=0\ncombined_paused=0\ncombined_app_home=0\ncombined_system_home=0\ncombined_unknown=0\npause_warming=0\npause_confirmed=0\npause_hold=0\nidle_overlap_unresolved=0\ntencent_shared_unresolved=0\nagent_restart_reset=0\nbilling_effect=none\n'
            exit 0
        fi
        awk -F, '
            NF==22 {
                rows++
                candidate=$18
                fresh=$22+0
                if (candidate=="repeated_report_not_new_evidence") repeated++
                if (candidate=="agent_stale") stale++
                if (fresh==1) {
                    fresh_n++
                    state=$17
                    if (state=="playing") playing++
                    else if (state=="paused") paused++
                    else if (state=="app_home") apphome++
                    else if (state=="system_home") syshome++
                    else unknown++

                    if (candidate=="pause_candidate_warming") warming++
                    else if (candidate=="paused_confirmed_temporal") confirmed++
                    else if (candidate=="paused_temporal_hold") hold++
                    else if (candidate=="player_idle_overlap_unresolved") idleoverlap++
                    else if (candidate=="tencent_shared_activity_unresolved") tencent++
                    else if (candidate=="agent_process_restart_context_reset") restart++
                }
                last_epoch=$1
            }
            END {
                print "schema=v3"
                print "rows=" rows+0
                print "fresh_reports=" fresh_n+0
                print "repeated_rows=" repeated+0
                print "stale_rows=" stale+0
                print "combined_playing=" playing+0
                print "combined_paused=" paused+0
                print "combined_app_home=" apphome+0
                print "combined_system_home=" syshome+0
                print "combined_unknown=" unknown+0
                print "pause_warming=" warming+0
                print "pause_confirmed=" confirmed+0
                print "pause_hold=" hold+0
                print "idle_overlap_unresolved=" idleoverlap+0
                print "tencent_shared_unresolved=" tencent+0
                print "agent_restart_reset=" restart+0
                print "last_sample_epoch=" last_epoch+0
                print "billing_effect=none"
            }' "$RAM/soak-v3.csv"
        exit 0 ;;
    history)
        if [ -r "$RAM/soak-v3.csv" ]; then
            printf '#schema=v3 epoch,age,package,activity,audio,screen,pps,network_shadow,adaptive_state,adaptive_score,adaptive_reason,pause_hint,pause_score,p50,p90,active_floor,combined_state,candidate,fusion_streak,report_seq,received_epoch,is_new_report\n'
            cat "$RAM/soak-v3.csv"
        elif [ -r "$RAM/soak-v2.csv" ]; then
            printf '#schema=v2 legacy epoch,age,package,activity,audio,screen,pps,network_shadow,candidate,report_seq,received_epoch,is_new_report\n'
            cat "$RAM/soak-v2.csv"
        elif [ -r "$RAM/soak.csv" ]; then
            printf '#schema=v1 legacy_history_do_not_count_duplicate_rows_as_new_reports\n'
            cat "$RAM/soak.csv"
        else
            echo "no samples"
        fi
        exit 0 ;;
    status) : ;;
    *) echo 'usage: tvguard-agent-bridge-report [doctor|status|summary|history|pairing]' >&2; exit 2 ;;
esac

[ -r "$LATEST" ] || {
    printf 'agent=missing\nactivity=unknown\ncombined_state=unknown\ncombined_candidate=agent_missing\nbilling_effect=none\n'
    exit 0
}
IFS='|' read -r seen pkg activity audio screen client_ms seq < "$LATEST" || :
case "${seen:-}" in ''|*[!0-9]*) echo 'agent=invalid'; exit 0 ;; esac
now="$(date +%s)"
age=$((now - seen))
if [ "$age" -lt 0 ] || [ "$age" -gt 35 ]; then
    # Forensics only: never present old player context as a live state.
    printf 'agent=stale\nage_seconds=%s\nlast_received_epoch=%s\nlast_report_seq=%s\nlast_package=%s\nactivity=unknown\ncombined_state=unknown\ncombined_candidate=agent_stale\nfusion_pause_streak=0\nbilling_effect=none\n' \
        "$age" "$seen" "${seq:-unknown}" "${pkg:-unknown}"
    exit 0
fi

network_pps=unknown
shadow=unknown
adaptive_state=unknown
adaptive_score=0
adaptive_reason=unknown
pause_hint=unknown
pause_score=0
adaptive_p50=0
adaptive_p90=0
active_floor=0

if [ -x /usr/libexec/tvguard-status ] && command -v jsonfilter >/dev/null 2>&1; then
    status="$(/usr/libexec/tvguard-status status 2>/dev/null || :)"
    if [ -n "$status" ]; then
        p="$(printf '%s' "$status" | jsonfilter -e '@.pps' 2>/dev/null || :)"
        s="$(printf '%s' "$status" | jsonfilter -e '@.shadow_label' 2>/dev/null || :)"
        ast="$(printf '%s' "$status" | jsonfilter -e '@.adaptive_state' 2>/dev/null || :)"
        asc="$(printf '%s' "$status" | jsonfilter -e '@.adaptive_score' 2>/dev/null || :)"
        ar="$(printf '%s' "$status" | jsonfilter -e '@.adaptive_reason' 2>/dev/null || :)"
        ph="$(printf '%s' "$status" | jsonfilter -e '@.adaptive_pause_hint' 2>/dev/null || :)"
        ps="$(printf '%s' "$status" | jsonfilter -e '@.adaptive_pause_score' 2>/dev/null || :)"
        p50="$(printf '%s' "$status" | jsonfilter -e '@.adaptive_window_p50' 2>/dev/null || :)"
        p90="$(printf '%s' "$status" | jsonfilter -e '@.adaptive_window_p90' 2>/dev/null || :)"
        af="$(printf '%s' "$status" | jsonfilter -e '@.adaptive_active_floor' 2>/dev/null || :)"

        case "$p" in ''|*[!0-9]*) : ;; *) network_pps="$p" ;; esac
        case "$s" in playing|idle|paused|app_home|system_home|sleep|unknown) shadow="$s" ;; esac
        case "$ast" in unready|warming|idle|active|ambiguous) adaptive_state="$ast" ;; esac
        case "$asc" in ''|*[!0-9]*) : ;; *) adaptive_score="$asc" ;; esac
        case "$ar" in
            none|no_model|need_sessions|overlap_model|need_window|clear_current|active_votes|active_median|stable_low|overlap)
                adaptive_reason="$ar" ;;
        esac
        case "$ph" in none|idle_overlap|bursty_pause|high_ratio_pause) pause_hint="$ph" ;; esac
        case "$ps" in ''|*[!0-9]*) : ;; *) pause_score="$ps" ;; esac
        case "$p50" in ''|*[!0-9]*) : ;; *) adaptive_p50="$p50" ;; esac
        case "$p90" in ''|*[!0-9]*) : ;; *) adaptive_p90="$p90" ;; esac
        case "$af" in ''|*[!0-9]*) : ;; *) active_floor="$af" ;; esac
    fi
fi

combined=unknown
candidate=unknown
fusion_streak=0

# Agent context older than 20 seconds is not allowed to advance or preserve a
# live pause decision even though the transport freshness cutoff is 35 seconds.
if [ "$age" -gt 20 ]; then
    candidate=agent_report_delayed
elif [ -x "$FUSION" ]; then
    fusion="$("$FUSION" "$now" "$seen" "$seq" "$pkg" "$activity" "$audio" "$screen" \
        "${network_pps:-0}" "$shadow" "$adaptive_state" "$adaptive_score" "$adaptive_reason" \
        "$pause_hint" "$pause_score" "$active_floor" 2>/dev/null || echo 'unknown fusion_error 0')"
    set -- $fusion
    if [ "$#" -eq 3 ]; then
        case "$1" in playing|paused|app_home|system_home|unknown) combined="$1" ;; esac
        case "$2" in ''|*[!A-Za-z0-9_]*) candidate=fusion_invalid ;; *) candidate="$2" ;; esac
        case "$3" in ''|*[!0-9]*) fusion_streak=0 ;; *) fusion_streak="$3" ;; esac
    else
        candidate=fusion_invalid
    fi
else
    candidate=fusion_missing
fi

printf 'agent=online\nage_seconds=%s\nreceived_epoch=%s\nreport_seq=%s\nclient_epoch_ms=%s\npackage=%s\nactivity=%s\naudio_active=%s\nscreen_on=%s\nnetwork_pps=%s\nnetwork_shadow=%s\nadaptive_state=%s\nadaptive_score=%s\nadaptive_reason=%s\npause_hint=%s\npause_score=%s\nadaptive_p50=%s\nadaptive_p90=%s\nadaptive_active_floor=%s\ncombined_state=%s\ncombined_candidate=%s\nfusion_pause_streak=%s\nbilling_effect=none\n' \
   "$age" "$seen" "$seq" "$client_ms" "$pkg" "$activity" "$audio" "$screen" \
   "$network_pps" "$shadow" "$adaptive_state" "$adaptive_score" "$adaptive_reason" \
   "$pause_hint" "$pause_score" "$adaptive_p50" "$adaptive_p90" "$active_floor" \
   "$combined" "$candidate" "$fusion_streak"
