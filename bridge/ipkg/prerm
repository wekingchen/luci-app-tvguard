#!/bin/sh
[ -n "${IPKG_INSTROOT:-}" ] && exit 0
/etc/init.d/tvguard-agent-bridge stop 2>/dev/null || :
/etc/init.d/tvguard-agent-bridge disable 2>/dev/null || :
# Remove only bridge RAM state; keep pairing key for safe reinstall.
rm -f /var/run/tvguard-agent-bridge/pair-window
rmdir /var/run/tvguard-agent-bridge/pair-claim 2>/dev/null || :
rm -f /var/run/tvguard-agent-bridge/latest /var/run/tvguard-agent-bridge/soak.csv /var/run/tvguard-agent-bridge/soak.tmp /var/run/tvguard-agent-bridge/soak-v2.csv /var/run/tvguard-agent-bridge/soak-v2.tmp /var/run/tvguard-agent-bridge/soak-v3.csv /var/run/tvguard-agent-bridge/soak-v3.tmp /var/run/tvguard-agent-bridge/fusion.state\nrmdir /var/run/tvguard-agent-bridge/fusion.lock 2>/dev/null || :
rmdir /var/run/tvguard-agent-bridge 2>/dev/null || :
exit 0
